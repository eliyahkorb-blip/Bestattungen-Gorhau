---
import PageLayout from '../../layouts/PageLayout.astro';
import StockPhoto from '../../components/ui/StockPhoto.astro';
import AccordionItem from '../../components/ui/AccordionItem.astro';
import { company } from '../../data/company';
import { withBase } from '../../utils/url';

/*
 * Diese Seite führt zusammen, was vorher auf drei Seiten verteilt war:
 * "Im Trauerfall", "Benötigte Dokumente" und "Formalitäten". Angehörige sollen
 * in einer belastenden Situation nicht durch Unterseiten navigieren müssen.
 * Die alten URLs werden per 301 hierher geleitet.
 */

const steps = [
  {
    t: 'Ruhe bewahren und uns anrufen',
    d: 'Es besteht kein Zeitdruck. Rufen Sie uns an. Wir besprechen mit Ihnen die nächsten Schritte und sind Tag und Nacht erreichbar.',
  },
  {
    t: 'Ärztliche Todesbescheinigung',
    d: 'Ein Arzt oder eine Ärztin stellt die Todesbescheinigung aus. Zu Hause verständigen Sie dazu den Hausarzt oder den ärztlichen Bereitschaftsdienst, in einer Einrichtung übernimmt dies das Personal.',
  },
  {
    t: 'Überführung in unsere Obhut',
    d: 'Nach Vorliegen der Todesbescheinigung holen wir die verstorbene Person ab und überführen sie würdevoll in unsere Räume.',
  },
  {
    t: 'Persönliches Beratungsgespräch',
    d: 'In Ruhe besprechen wir Bestattungsart, Ablauf und persönliche Wünsche. Bringen Sie die Unterlagen mit, soweit sie vorliegen.',
  },
  {
    t: 'Organisation und Formalitäten',
    d: 'Wir übernehmen die Behördengänge, die Abstimmung mit Friedhof oder Krematorium und die Gestaltung von Trauerfeier und Trauerdruck.',
  },
];

const urkunden = [
  { t: 'ledig', items: ['Personalausweis oder Reisepass', 'Geburtsurkunde'] },
  {
    t: 'verheiratet',
    items: ['Personalausweis oder Reisepass', 'Heiratsurkunde oder Familienstammbuch'],
  },
  {
    t: 'verwitwet',
    items: [
      'Personalausweis oder Reisepass',
      'Heiratsurkunde oder Familienstammbuch',
      'Sterbeurkunde des Ehepartners',
    ],
  },
  {
    t: 'geschieden',
    items: [
      'Personalausweis oder Reisepass',
      'Heiratsurkunde oder Familienstammbuch',
      'Rechtskräftiges Scheidungsurteil',
    ],
  },
];

const weitere = [
  'Ärztliche Todesbescheinigung, wird vom Arzt ausgestellt',
  'Krankenversicherungskarte',
  'Rentennummer oder Rentenbescheid, falls vorhanden',
  'Unterlagen zu einer bestehenden Vorsorge oder Sterbegeldversicherung',
  'Grabdokumente bei einer vorhandenen Grabstätte',
];

const formalitaeten = [
  'Beurkundung des Sterbefalls beim Standesamt',
  'Anmeldung bei Friedhof oder Krematorium',
  'Trauerfeier- und Bestattungstermin',
  'Renten- und Versicherungsanträge',
  'Abmeldungen und Anträge bei Behörden',
  'Überführungen aus dem und ins Ausland',
];

const faqs = [
  {
    q: 'Was muss ich als Erstes tun, wenn jemand verstorben ist?',
    a: 'Bewahren Sie Ruhe. Es besteht kein Zeitdruck. Verständigen Sie zunächst einen Arzt für die Todesbescheinigung und rufen Sie uns dann an. Wir übernehmen alle weiteren Schritte gemeinsam mit Ihnen.',
  },
  {
    q: 'Sind Sie auch nachts und am Wochenende erreichbar?',
    a: 'Ja. Im Trauerfall sind wir für Sie Tag und Nacht erreichbar. Für organisatorische Fragen erreichen Sie unser Büro zu den regulären Zeiten von Montag bis Freitag, 08:00 bis 16:00 Uhr.',
  },
  {
    q: 'Welche Unterlagen werden benötigt?',
    a: 'Je nach Familienstand der verstorbenen Person werden Personalausweis, Geburts- oder Heiratsurkunde und gegebenenfalls Sterbeurkunde des Ehepartners oder Scheidungsurteil benötigt, dazu die ärztliche Todesbescheinigung. Die vollständige Checkliste steht auf dieser Seite.',
  },
  {
    q: 'Was kostet ein erstes Beratungsgespräch?',
    a: 'Das erste Gespräch ist für Sie unverbindlich. Wir nehmen uns Zeit, hören zu und beraten Sie zu allen Möglichkeiten, ohne Verpflichtung.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<PageLayout
  title="Im Trauerfall: Erste Schritte | Gorhau Würzburg"
  description="Was ist im Trauerfall zu tun? Erste Schritte, benötigte Unterlagen und die Formalitäten, die wir übernehmen. Bestattungen Gorhau in Würzburg ist Tag und Nacht erreichbar."
  path="/im-trauerfall/"
  eyebrow="Erste Hilfe im Trauerfall"
  heading="Im Trauerfall sind wir für Sie da"
  intro="Wenn ein Mensch verstorben ist, stellt sich vieles gleichzeitig. Sie müssen jetzt nichts allein regeln. Auf dieser Seite steht alles, was in den ersten Tagen wichtig ist."
  breadcrumbs={[{ name: 'Im Trauerfall', path: '/im-trauerfall/' }]}
  jsonLd={[faqLd]}
  ctaLabel="Im Trauerfall anrufen"
  ctaHref={`tel:${company.phoneRaw}`}
  ctaHint="Wir sind Tag und Nacht erreichbar."
>
  <h2>Was jetzt zuerst wichtig ist</h2>
  <hr class="accent-rule" />
  <div class="lead-block">
    <div class="prose">
      <p>
        Der Verlust eines nahen Menschen ist ein tiefer Einschnitt. In den ersten Stunden wirkt
        vieles überwältigend. Das Wichtigste zuerst: Es besteht kein Zeitdruck. Nehmen Sie sich
        einen Moment. Die notwendigen Schritte gehen wir anschließend gemeinsam.
      </p>
      <p>
        Gesetzlich vorgeschrieben ist zunächst nur eines: Ein Arzt muss den Tod feststellen und
        die Todesbescheinigung ausstellen. Alles Weitere hat Zeit, bis Sie so weit sind.
      </p>
    </div>
    <StockPhoto
      name="trauernde-umarmung"
      alt="Zwei trauernde Menschen stehen eng beieinander, von hinten aufgenommen"
      sizes="(min-width: 60rem) 22rem, 92vw"
      priority
      class="lead-block__photo"
    />
  </div>

  <h2>Wen Sie anrufen können</h2>
  <hr class="accent-rule" />
  <div class="call-now">
    <p class="call-now__label">Im Trauerfall Tag und Nacht erreichbar</p>
    <p class="call-now__number">
      <a href={`tel:${company.phoneRaw}`}>{company.phone}</a>
    </p>
    <p class="call-now__note">
      Rufen Sie an, sobald Sie so weit sind. Sie müssen nichts vorbereiten und keine Unterlagen
      zur Hand haben. Wir klären am Telefon, was als Nächstes zu tun ist.
    </p>
  </div>

  <h2>Die ersten Schritte</h2>
  <hr class="accent-rule" />
  <ol class="steps">
    {
      steps.map((s) => (
        <li class="steps__item">
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))
    }
  </ol>

  <h2>Benötigte Unterlagen</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Welche Urkunden gebraucht werden, hängt vom Familienstand der verstorbenen Person ab. Sie
      werden vor allem für die Beurkundung des Sterbefalls beim Standesamt benötigt. Machen Sie
      sich keine Sorgen, wenn etwas fehlt: Wir gehen die Liste gemeinsam durch und helfen auch
      dabei, Ersatzausfertigungen beim Standesamt zu beantragen.
    </p>
  </div>

  <div class="checklist">
    {
      urkunden.map((g) => (
        <div class="checklist__group">
          <h3 class="checklist__title">Verstorbene Person war {g.t}</h3>
          <ul class="checklist__items">
            {g.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <h3 class="checklist__further-title">Zusätzlich hilfreich</h3>
  <ul class="checklist__items checklist__items--wide">
    {weitere.map((f) => <li>{f}</li>)}
  </ul>

  <h2>Formalitäten, die wir übernehmen</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Den Papierkram müssen Sie nicht selbst erledigen. Die Sterbeurkunde wird erst nach der
      Beurkundung beim Standesamt ausgestellt und für viele weitere Schritte gebraucht, etwa
      für Anträge bei Versicherungen oder für Bankangelegenheiten. Wir kennen diese Abläufe und
      sorgen dafür, dass nichts unnötig verzögert wird.
    </p>
  </div>
  <ul class="chip-list">
    {formalitaeten.map((f) => <li>{f}</li>)}
  </ul>

  <h2>Was Sie nicht sofort erledigen müssen</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Manches muss kurzfristig geregelt werden, vieles hat mehr Zeit als gedacht. Kündigungen
      von Verträgen, Abonnements und Mitgliedschaften, die Wohnungsauflösung und erbrechtliche
      Fragen können warten. Wir sortieren im Beratungsgespräch gemeinsam, was eilt und was
      nicht.
    </p>
  </div>

  <AccordionItem title="Was außerhalb unserer Leistungen liegt">
    <p>
      Kündigungen von Mitgliedschaften, Verträgen oder Abonnements der verstorbenen Person
      sowie erbrechtliche Fragen gehören nicht zu unserem Leistungsumfang. Wir weisen Sie im
      Beratungsgespräch darauf hin und nennen bei Bedarf geeignete Ansprechpartner, etwa
      Notariate oder Rechtsanwaltskanzleien.
    </p>
  </AccordionItem>

  <h2>Häufige Fragen im Trauerfall</h2>
  <hr class="accent-rule" />
  <div class="faq">
    {
      faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>

  <h2>Kontakt</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Sie erreichen uns unter <a href={`tel:${company.phoneRaw}`}>{company.phone}</a> oder per
      E-Mail an <a href={`mailto:${company.email}`}>{company.email}</a>. Unser Büro finden Sie
      in der {company.street} in {company.city}-{company.district}. Anfahrt und Bürozeiten
      stehen auf der Seite <a href={withBase('/kontakt/')}>Kontakt</a>.
    </p>
  </div>
</PageLayout>

<style>
  /* Text und Bild nebeneinander statt Bild über volle Breite: die Seite soll
     sofort mit Inhalt beginnen, nicht mit einer großen Bildfläche. */
  .lead-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    gap: var(--space-2xl);
    align-items: start;
    margin-top: var(--space-lg);
  }
  .lead-block :global(.lead-block__photo img) {
    border-radius: var(--radius-md);
  }
  @media (max-width: 60rem) {
    .lead-block {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  /* Die Telefonnummer ist auf dieser Seite die wichtigste Information. */
  .call-now {
    margin-top: var(--space-lg);
    padding: var(--space-xl);
    background: var(--surface-cream);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    max-width: 42rem;
  }
  .call-now__label {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .call-now__number {
    margin: var(--space-sm) 0 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
    line-height: 1.2;
  }
  .call-now__number a {
    color: var(--brand-bordeaux-dark);
    text-decoration: none;
  }
  .call-now__note {
    margin-top: var(--space-md);
    color: var(--text-muted);
  }

  .steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    display: grid;
    gap: var(--space-md);
    max-width: none;
    margin-top: var(--space-lg);
  }
  .steps__item {
    counter-increment: step;
    position: relative;
    padding: var(--space-lg) var(--space-lg) var(--space-lg) 4.5rem;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .steps__item::before {
    content: counter(step);
    position: absolute;
    left: var(--space-lg);
    top: var(--space-lg);
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--brand-bordeaux);
    color: var(--brand-white);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .steps__item h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .steps__item p {
    margin-top: var(--space-sm);
    color: var(--text-muted);
    max-width: 44rem;
  }

  /* Checkliste statt Kartenraster: übersichtlich und zum Abhaken. */
  .checklist {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-lg) var(--space-2xl);
    margin-top: var(--space-lg);
    max-width: none;
  }
  .checklist__title,
  .checklist__further-title {
    font-size: 1rem;
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0;
    margin: 0 0 var(--space-sm);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--border-subtle);
  }
  .checklist__further-title {
    margin-top: var(--space-xl);
    max-width: 42rem;
  }
  .checklist__items {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .checklist__items--wide {
    max-width: 42rem;
  }
  .checklist__items li {
    position: relative;
    padding-left: 1.75rem;
    color: var(--text-muted);
  }
  .checklist__items li + li {
    margin-top: var(--space-sm);
  }
  /* Häkchen als reines CSS-Zeichen, kein Bild und kein Emoji. */
  .checklist__items li::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.45em;
    width: 0.42rem;
    height: 0.75rem;
    border-right: 2px solid var(--brand-gold-text);
    border-bottom: 2px solid var(--brand-gold-text);
    transform: rotate(45deg);
  }

  .faq {
    max-width: 46rem;
    margin-top: var(--space-lg);
  }
  .faq__item {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-sm);
    background: var(--surface);
  }
  .faq__item summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--brand-bordeaux-dark);
    padding: var(--space-2xs) 0;
  }
  .faq__item summary:hover {
    color: var(--brand-bordeaux);
  }
  .faq__item p {
    margin-top: var(--space-sm);
    color: var(--text-muted);
  }
</style>
