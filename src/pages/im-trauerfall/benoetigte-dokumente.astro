---
import PageLayout from '../../layouts/PageLayout.astro';
import Motif from '../../components/illustrations/Motif.astro';
import { company } from '../../data/company';
import { withBase } from '../../utils/url';

const groups = [
  {
    t: 'Bei ledigen Verstorbenen',
    items: ['Personalausweis oder Reisepass', 'Geburtsurkunde'],
  },
  {
    t: 'Bei verheirateten Verstorbenen',
    items: ['Personalausweis oder Reisepass', 'Heiratsurkunde bzw. Familienstammbuch'],
  },
  {
    t: 'Bei verwitweten Verstorbenen',
    items: [
      'Personalausweis oder Reisepass',
      'Heiratsurkunde bzw. Familienstammbuch',
      'Sterbeurkunde des Ehepartners',
    ],
  },
  {
    t: 'Bei geschiedenen Verstorbenen',
    items: [
      'Personalausweis oder Reisepass',
      'Heiratsurkunde bzw. Familienstammbuch',
      'Rechtskräftiges Scheidungsurteil',
    ],
  },
];

const further = [
  'Ärztliche Todesbescheinigung (wird vom Arzt ausgestellt)',
  'Krankenversicherungskarte',
  'Rentennummer bzw. Rentenbescheid, falls vorhanden',
  'Unterlagen zu einer bestehenden Bestattungsvorsorge oder Sterbegeldversicherung',
  'Grabdokumente bei einer vorhandenen Grabstätte',
];
---

<PageLayout
  title="Benötigte Dokumente im Trauerfall | Bestattungen Gorhau Würzburg"
  description="Welche Unterlagen werden im Trauerfall benötigt? Übersicht der Dokumente – nach Familienstand geordnet. Bestattungen Gorhau in Würzburg hilft Ihnen weiter."
  eyebrow="Checkliste"
  path="/im-trauerfall/benoetigte-dokumente/"
  heading="Benötigte Unterlagen und Dokumente"
  intro="Damit wir für Sie alle Formalitäten erledigen können, benötigen wir einige Unterlagen. Welche das sind, hängt vom Familienstand der verstorbenen Person ab."
  breadcrumbs={[
    { name: 'Im Trauerfall', path: '/im-trauerfall/' },
    { name: 'Benötigte Dokumente', path: '/im-trauerfall/benoetigte-dokumente/' },
  ]}
  ctaLabel="Im Trauerfall anrufen"
  ctaHref={`tel:${company.phoneRaw}`}
  ctaHint="Unsicher wegen fehlender Unterlagen? Wir helfen sofort weiter."
>
  <figure class="page-motif">
    <Motif name="formalitaeten" label="Dokument mit Häkchen als Symbol für vollständige Unterlagen" />
  </figure>

  <div class="prose">
    <p>
      Bitte machen Sie sich keine Sorgen, wenn nicht alle Unterlagen sofort auffindbar sind.
      Wir gehen die Liste gemeinsam mit Ihnen durch und finden für fehlende Dokumente eine
      Lösung.
    </p>
    <p>
      Die persönlichen Urkunden werden vor allem für die Beurkundung des Sterbefalls beim
      Standesamt benötigt. Erst mit der ausgestellten Sterbeurkunde können anschließend weitere
      Schritte erfolgen – etwa die Anmeldung bei Friedhof oder Krematorium sowie Anträge bei
      Versicherungen und Behörden. Mehr dazu finden Sie auf unserer Seite
      <a href={withBase('/leistungen/formalitaeten/')}>Formalitäten</a>.
    </p>
  </div>

  <h2>Persönliche Urkunden nach Familienstand</h2>
  <hr class="accent-rule" />
  <div class="grid grid--2">
    {
      groups.map((g) => (
        <article class="card">
          <h3>{g.t}</h3>
          <ul>
            {g.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <h2>Weitere hilfreiche Unterlagen</h2>
  <hr class="accent-rule" />
  <ul class="prose">
    {further.map((f) => <li>{f}</li>)}
  </ul>

  <div class="prose">
    <p>
      Sollten einzelne Urkunden fehlen, unterstützen wir Sie auch dabei, Ersatzausfertigungen
      beim zuständigen Standesamt zu beantragen.
    </p>
  </div>

  <p class="related-link">
    Verwandtes Thema: <a href={withBase('/im-trauerfall/')}>Erste Schritte im Trauerfall</a>
  </p>
</PageLayout>
