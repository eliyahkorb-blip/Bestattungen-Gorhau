---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaSection from '../components/CtaSection.astro';
import HeroVisual from '../components/ui/HeroVisual.astro';
import IconFeature from '../components/ui/IconFeature.astro';
import FactStrip from '../components/ui/FactStrip.astro';
import WaveDivider from '../components/ui/WaveDivider.astro';
import Icon from '../components/icons/Icon.astro';
import Motif from '../components/illustrations/Motif.astro';
import { company } from '../data/company';
import { withBase } from '../utils/url';

const leistungenAuswahl = [
  { name: 'ueberfuehrung' as const, t: 'Überführungen', d: 'Im In- und Ausland würdevoll organisiert.', href: '/leistungen/ueberfuehrungen/' },
  { name: 'thanatopraxie' as const, t: 'Thanatopraxie', d: 'Hygienische und ästhetische Versorgung.', href: '/leistungen/thanatopraxie/' },
  { name: 'trauerfeier' as const, t: 'Trauerfeier & Trauerdruck', d: 'Reden, Drucksachen, Dekoration.', href: '/leistungen/trauerfeier-und-trauerdruck/' },
];

const bestattungsartenAuswahl = [
  { name: 'erdbestattung' as const, t: 'Erdbestattung', href: '/bestattungsarten/erdbestattung/' },
  { name: 'feuerbestattung' as const, t: 'Feuerbestattung', href: '/bestattungsarten/feuerbestattung/' },
  { name: 'seebestattung' as const, t: 'Seebestattung', href: '/bestattungsarten/seebestattung/' },
  { name: 'anonyme-bestattung' as const, t: 'Anonyme Bestattung', href: '/bestattungsarten/anonyme-bestattung/' },
];

const orientation = [
  {
    icon: 'compass' as const,
    title: 'Im Trauerfall',
    text: 'Erste Schritte, ruhig und ohne Zeitdruck erklärt.',
    href: '/im-trauerfall/',
  },
  {
    icon: 'leaf' as const,
    title: 'Bestattungsarten',
    text: 'Erd-, Feuer-, See- und anonyme Bestattung im Überblick.',
    href: '/bestattungsarten/',
  },
  {
    icon: 'document' as const,
    title: 'Vorsorge',
    text: 'Wünsche zu Lebzeiten festhalten, Angehörige entlasten.',
    href: '/bestattungsvorsorge/',
  },
  {
    icon: 'window-light' as const,
    title: 'Abschiedsraum',
    text: 'Raum und Zeit für einen persönlichen Abschied.',
    href: '/abschiedsraum/',
  },
];

const reasons = [
  {
    icon: 'family' as const,
    title: 'Familiengeführt seit 1970',
    text: 'Kein anonymes Unternehmen – feste Ansprechpartner vor Ort.',
    href: '/ueber-uns/',
  },
  {
    icon: 'clock' as const,
    title: 'Tag und Nacht erreichbar',
    text: 'Im Trauerfall sind wir jederzeit für Sie da.',
    href: '/kontakt/',
  },
  {
    icon: 'embrace' as const,
    title: 'Alles aus einer Hand',
    text: 'Überführung, Formalitäten und Trauerfeier – koordiniert.',
    href: '/leistungen/',
  },
  {
    icon: 'window-light' as const,
    title: 'Individuelle Abschiednahme',
    text: 'Im Abschiedsraum, kirchlich oder in stillem Rahmen.',
    href: '/abschiedsraum/',
  },
];

const facts = [
  { value: '1970', label: 'gegründet' },
  { value: '1980', label: 'in der Reuterstraße' },
  { value: '2004', label: 'Abschiedsraum eröffnet' },
  { value: '24/7', label: 'im Trauerfall erreichbar' },
];
---

<BaseLayout
  title="Bestattungen Gorhau in Würzburg-Heidingsfeld | Bestatter seit 1970"
  description="Bestattungs- und Überführungs-Institut Gorhau in Würzburg-Heidingsfeld: familiengeführt seit 1970. Persönlich an Ihrer Seite im Trauerfall, bei der Vorsorge und beim würdevollen Abschied."
  path="/"
  includeBusinessLd={true}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text-col">
        <p class="eyebrow">Familienunternehmen seit 1970 · Würzburg-Heidingsfeld</p>
        <h1>Bestattungen Gorhau in Würzburg</h1>
        <p class="hero__sub">
          Persönlich an Ihrer Seite – im Trauerfall, bei der Vorsorge und bei allen Fragen rund
          um einen würdevollen Abschied.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={`tel:${company.phoneRaw}`}>
            <Icon name="phone" size={18} /> Im Trauerfall anrufen
          </a>
          <a class="btn btn--secondary" href={withBase('/bestattungsvorsorge/')}>Vorsorge besprechen</a>
        </div>
        <p class="hero__note">{company.emergencyNote}</p>
      </div>
      <div class="hero__visual-col" aria-hidden="true">
        <HeroVisual />
      </div>
    </div>
  </section>

  <WaveDivider fill="var(--surface-beige)" />

  <!-- Schnelle Orientierung -->
  <section class="section section--beige">
    <div class="container">
      <p class="eyebrow">Schnelle Orientierung</p>
      <h2>Wobei können wir Ihnen helfen?</h2>
      <div class="tile-grid">
        {orientation.map((o) => <IconFeature icon={o.icon} title={o.title} text={o.text} href={o.href} />)}
      </div>
    </div>
  </section>

  <!-- Philosophie -->
  <section class="section section--white philosophy">
    <div class="container">
      <p class="eyebrow">Unsere Haltung</p>
      <h2 class="philosophy__words">
        <span>Zuhören</span><span aria-hidden="true">·</span>
        <span>Beraten</span><span aria-hidden="true">·</span>
        <span>Begleiten</span>
      </h2>
      <p class="philosophy__text">
        So arbeiten wir seit 1970 als Familienunternehmen – persönlich, ohne Druck und mit
        offenem Ohr für das, was Ihnen wichtig ist.
      </p>
      <div class="pillar-row">
        <div class="pillar">
          <Icon name="embrace" size={28} class="pillar__icon" />
          <h3>Zuhören</h3>
          <p>Erst das Gespräch, dann das Formular.</p>
        </div>
        <div class="pillar">
          <Icon name="document" size={28} class="pillar__icon" />
          <h3>Beraten</h3>
          <p>Offen und ohne Fachjargon – Sie entscheiden.</p>
        </div>
        <div class="pillar">
          <Icon name="family" size={28} class="pillar__icon" />
          <h3>Begleiten</h3>
          <p>Vom ersten Anruf bis über die Bestattung hinaus.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Fakten -->
  <section class="section section--cream fact-band">
    <div class="container">
      <FactStrip facts={facts} />
    </div>
  </section>

  <!-- Unternehmensbild und kurze Vorstellung -->
  <section class="section section--white">
    <div class="container split split--reverse">
      <div class="split__aside">
        <Motif name="gebaeude" label="Symbolisches Gebäudemotiv" />
      </div>
      <div>
        <p class="eyebrow">Wer wir sind</p>
        <h2>Ein Familienunternehmen in Würzburg-Heidingsfeld</h2>
        <p>
          Seit 1970 sind wir in der Reuterstraße für die Menschen in Würzburg und der Region da –
          inhabergeführt, mit festen Ansprechpartnern statt anonymer Zentrale.
        </p>
        <p><a class="card__link" href={withBase('/ueber-uns/')}>Mehr über uns →</a></p>
      </div>
    </div>
  </section>

  <!-- Ausgewählte Leistungen -->
  <section class="section section--beige">
    <div class="container">
      <p class="eyebrow">Unser Leistungsspektrum</p>
      <h2>Ausgewählte Leistungen</h2>
      <div class="motif-tile-grid">
        {leistungenAuswahl.map((l) => (
          <a class="motif-tile" href={withBase(l.href)}>
            <Motif name={l.name} label={l.t} class="motif-tile__img" />
            <h3>{l.t}</h3>
            <p>{l.d}</p>
          </a>
        ))}
      </div>
      <p class="leistungen-links">
        <a href={withBase('/leistungen/')}>Alle Leistungen im Überblick →</a>
      </p>
    </div>
  </section>

  <!-- Was uns ausmacht -->
  <section class="section section--white">
    <div class="container">
      <p class="eyebrow">Was uns ausmacht</p>
      <h2>Kein Standardablauf, sondern Ihre Situation</h2>
      <div class="tile-grid">
        {reasons.map((r) => <IconFeature icon={r.icon} title={r.title} text={r.text} href={r.href} />)}
      </div>
    </div>
  </section>

  <!-- Bestattungsarten als visuelle Auswahl -->
  <section class="section section--cream">
    <div class="container">
      <p class="eyebrow">Möglichkeiten des Abschieds</p>
      <h2>Bestattungsarten im Überblick</h2>
      <div class="motif-tile-grid motif-tile-grid--four">
        {bestattungsartenAuswahl.map((b) => (
          <a class="motif-tile" href={withBase(b.href)}>
            <Motif name={b.name} label={b.t} class="motif-tile__img" />
            <h3>{b.t}</h3>
          </a>
        ))}
      </div>
      <p class="leistungen-links">
        <a href={withBase('/bestattungsarten/')}>Alle Bestattungsarten im Vergleich →</a>
      </p>
    </div>
  </section>

  <!-- Abschiedsraum -->
  <section class="section section--white">
    <div class="container split">
      <div>
        <p class="eyebrow">Raum und Zeit</p>
        <h2>Unser hauseigener Abschiedsraum</h2>
        <p>
          Seit 2004 bieten wir in Würzburg einen eigenen Abschiedsraum – für einen persönlichen
          Abschied im kleinen Kreis, ganz ohne Zeitdruck.
        </p>
        <p><a class="btn btn--secondary" href={withBase('/abschiedsraum/')}>Abschiedsraum kennenlernen</a></p>
      </div>
      <div class="split__aside">
        <Motif name="abschiedsraum" label="Fenster mit sanftem Lichteinfall" />
      </div>
    </div>
  </section>

  <!-- Vorsorge + Über uns -->
  <section class="section section--white">
    <div class="container grid grid--2">
      <article class="mini-card">
        <h2>Bestattungsvorsorge</h2>
        <p>
          Legen Sie zu Lebzeiten fest, wie Ihr Abschied gestaltet werden soll, und entlasten Sie
          Ihre Angehörigen – organisatorisch wie finanziell.
        </p>
        <a class="card__link" href={withBase('/bestattungsvorsorge/')}>Zur Vorsorge →</a>
      </article>
      <article class="mini-card">
        <h2>Über uns</h2>
        <p>
          Handwerkliches Können, persönliche Nähe und regionale Verbundenheit prägen unsere
          Arbeit seit über fünf Jahrzehnten.
        </p>
        <a class="card__link" href={withBase('/ueber-uns/')}>Mehr über uns →</a>
      </article>
    </div>
  </section>

  <!-- Geschichte -->
  <section class="section section--cream">
    <div class="container">
      <p class="eyebrow">Seit 1970</p>
      <h2>Eine Würzburger Geschichte</h2>
      <p class="history-lead">
        Aus einem Familienbetrieb ist über die Jahrzehnte ein fester Bestandteil der Region
        geworden. Ein historisches Dokument aus unserem Archiv finden Sie in unserer
        <a href={withBase('/mediathek/')}>Mediathek</a>.
      </p>
      <FactStrip facts={facts.slice(0, 3)} />
      <p class="history-link"><a class="btn btn--secondary" href={withBase('/ueber-uns/historie/')}>Unsere Historie ansehen</a></p>
    </div>
  </section>

  <!-- Kontakt / Standort -->
  <section class="section section--white">
    <div class="container split">
      <div>
        <h2>Kontakt &amp; Standort</h2>
        <address class="contact-block">
          <strong>{company.name}</strong><br />
          {company.street}, {company.postalCode} {company.city}-{company.district}<br />
          <a href={`tel:${company.phoneRaw}`}>{company.phone}</a> ·
          <a href={`mailto:${company.email}`}>{company.email}</a>
        </address>
        <p class="contact-block__hours">
          Mo–Fr 08:00–16:00 Uhr sowie nach Vereinbarung ·
          <a href={withBase('/kontakt/')}>Anfahrt &amp; weitere Kontaktwege</a>
        </p>
      </div>
      <div class="split__aside">
        <p><a class="btn btn--primary" href={withBase('/kontakt/')}>Anfahrt &amp; Kontakt</a></p>
        <p><a href={company.maps.osm} rel="noopener">Standort auf OpenStreetMap ansehen</a></p>
      </div>
    </div>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(180deg, var(--surface-cream), var(--brand-white));
    padding-block: var(--space-2xl) var(--space-lg);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-2xl);
    align-items: center;
  }
  @media (max-width: 780px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__visual-col {
      order: -1;
      max-width: 14rem;
      margin-inline: auto;
    }
  }
  .hero__sub {
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.35rem);
    color: var(--text-primary);
    margin-top: var(--space-md);
    max-width: 34rem;
    line-height: 1.55;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }
  .hero__note {
    margin-top: var(--space-lg);
    font-weight: 600;
    color: var(--brand-bordeaux);
  }

  .tile-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    margin-top: var(--space-lg);
    max-width: none;
  }

  .philosophy__words {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 1.2rem + 1.6vw, 2.2rem);
    color: var(--brand-bordeaux-dark);
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    margin-block: var(--space-sm);
    max-width: none;
  }
  .philosophy__words span[aria-hidden] {
    color: var(--brand-gold);
  }
  .philosophy__text {
    max-width: 38rem;
  }
  .pillar-row {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    margin-top: var(--space-xl);
    max-width: none;
  }
  .pillar {
    text-align: left;
  }
  .pillar :global(.pillar__icon) {
    color: var(--brand-gold-dark);
    margin-bottom: var(--space-xs);
  }
  .pillar h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }
  .pillar p {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .fact-band {
    padding-block: var(--space-xl);
  }

  .leistungen-links {
    margin-top: var(--space-lg);
    color: var(--text-muted);
    max-width: none;
  }

  .split {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    align-items: center;
  }
  .split--reverse {
    direction: rtl;
  }
  .split--reverse > * {
    direction: ltr;
  }
  .split__aside p + p {
    margin-top: var(--space-md);
  }
  .split__aside :global(.motif) {
    max-width: 20rem;
    margin-inline: auto;
  }

  .motif-tile-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    margin-top: var(--space-lg);
    max-width: none;
  }
  .motif-tile-grid--four {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
  }
  .motif-tile {
    display: block;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .motif-tile:hover {
    border-color: var(--brand-gold);
    transform: translateY(-2px);
  }
  .motif-tile :global(.motif-tile__img) {
    max-width: 8rem;
    margin: 0 auto var(--space-sm);
  }
  .motif-tile h3 {
    font-size: 1rem;
    color: var(--brand-bordeaux-dark);
    text-align: center;
    margin-bottom: 0.2rem;
  }
  .motif-tile p {
    color: var(--text-muted);
    font-size: 0.88rem;
    text-align: center;
    margin: 0;
  }

  .contact-block {
    font-style: normal;
    line-height: 1.8;
    margin-block: var(--space-md);
  }
  .contact-block__hours {
    margin-top: var(--space-sm);
    color: var(--text-muted);
  }

  .mini-card h2 {
    font-size: 1.3rem;
  }
  .mini-card p {
    color: var(--text-muted);
  }

  .history-lead {
    max-width: 40rem;
  }
  .history-link {
    margin-top: var(--space-lg);
  }
</style>
