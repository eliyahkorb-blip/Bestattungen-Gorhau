---
import PageLayout from '../layouts/PageLayout.astro';
import { withBase } from '../utils/url';
---

<PageLayout
  title="Mediathek | Bestattungen Gorhau Würzburg"
  description="Die Mediathek von Bestattungen Gorhau in Würzburg: historisches Pressematerial aus der Firmengeschichte."
  eyebrow="Aus unserem Archiv"
  path="/mediathek/"
  heading="Mediathek"
  intro="Ein Blick in unser Firmenarchiv."
  breadcrumbs={[{ name: 'Mediathek', path: '/mediathek/' }]}
>
  <figure class="historic-figure">
    <span class="media-item__tag">Archiv · 2009</span>
    <picture>
      <source type="image/avif" srcset={withBase('/img/content/flyer_2009.avif')} />
      <source type="image/webp" srcset={withBase('/img/content/flyer_2009.webp')} />
      <img
        src={withBase('/img/content/flyer_2009.jpg')}
        width="1200"
        height="865"
        loading="lazy"
        decoding="async"
        alt="Historische Anzeige des Bestattungsinstituts Gorhau von 2009: Ankündigung „Würzburgs erstes Bestattungshaus mit eigenem Abschiedsraum“ und Einladung zum Tag der offenen Tür am 6. Juni 2009."
      />
    </picture>
    <figcaption>
      <strong>Historische Anzeige, 2009.</strong> Einladung zum Tag der offenen Tür und Hinweis
      auf den damals ersten hauseigenen Abschiedsraum in Würzburg. Dieses Material ist ein
      historisches Dokument aus dem Jahr 2009 und gibt den damaligen Stand wieder – Angaben,
      Preise und Konditionen können überholt sein.
    </figcaption>
  </figure>

  <p class="related-link">
    Verwandte Themen: <a href={withBase('/ueber-uns/historie/')}>Historie seit 1970</a> ·
    <a href={withBase('/ueber-uns/galerie/')}>Galerie</a>
  </p>
</PageLayout>

<style>
  .media-item__tag {
    display: inline-block;
    background: var(--brand-gold-dark);
    color: var(--brand-white);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.2em 0.6em;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-sm);
  }
  .historic-figure {
    margin: 0;
    max-width: 46rem;
    background: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }
  .historic-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
  }
  .historic-figure figcaption {
    margin-top: var(--space-sm);
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
