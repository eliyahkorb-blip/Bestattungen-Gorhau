---
import PageLayout from '../../layouts/PageLayout.astro';
import AccordionItem from '../../components/ui/AccordionItem.astro';
import Motif from '../../components/illustrations/Motif.astro';
import { withBase } from '../../utils/url';
---

<PageLayout
  title="Behördengänge und Formalitäten | Bestattungen Gorhau Würzburg"
  description="Bestattungen Gorhau in Würzburg übernimmt für Sie die Formalitäten: Sterbeurkunde, Abmeldungen, Anträge und Behördengänge. Wir nehmen Ihnen den Papierkram ab."
  eyebrow="Leistungen"
  path="/leistungen/formalitaeten/"
  heading="Behördengänge und organisatorische Unterstützung"
  intro="Der Papierkram nach einem Todesfall kann belastend sein. Wir erledigen die notwendigen Schritte in Ihrem Auftrag."
  breadcrumbs={[
    { name: 'Leistungen', path: '/leistungen/' },
    { name: 'Formalitäten', path: '/leistungen/formalitaeten/' },
  ]}
>
  <figure class="page-motif">
    <Motif name="formalitaeten" label="Dokument mit Häkchen als Symbol für erledigte Formalitäten" />
  </figure>

  <h2>Formalitäten, die wir für Sie übernehmen</h2>
  <hr class="accent-rule" />
  <ul class="chip-list">
    <li>Beurkundung des Sterbefalls</li>
    <li>Anmeldung bei Friedhof / Krematorium</li>
    <li>Trauerfeier- und Bestattungstermin</li>
    <li>Renten- und Versicherungsanträge</li>
    <li>Abmeldungen und Anträge</li>
    <li>Überführungen aus dem/ins Ausland</li>
  </ul>

  <div class="prose">
    <p>
      Die Sterbeurkunde wird erst nach der Beurkundung beim Standesamt ausgestellt – und für
      zahlreiche weitere Schritte benötigt, etwa Anträge bei Versicherungen oder
      Bankangelegenheiten. Wir kennen diese Abläufe und sorgen dafür, dass nichts unnötig
      verzögert wird. Manches muss kurzfristig erledigt werden, anderes hat mehr zeitlichen
      Spielraum – wir sortieren das gemeinsam mit Ihnen.
    </p>
  </div>

  <AccordionItem title="Was Sie selbst regeln müssen">
    <p>
      Einige Angelegenheiten liegen außerhalb unseres Leistungsspektrums – etwa die Kündigung
      von Mitgliedschaften, Verträgen oder Abonnements der verstorbenen Person sowie
      erbrechtliche Fragen. Wir weisen Sie im Beratungsgespräch darauf hin und nennen bei Bedarf
      geeignete Ansprechpartner, etwa Notariate oder Rechtsanwaltskanzleien.
    </p>
  </AccordionItem>

  <p class="related-link">
    Verwandte Themen: <a href={withBase('/im-trauerfall/benoetigte-dokumente/')}>Benötigte Dokumente</a> ·
    <a href={withBase('/im-trauerfall/')}>Im Trauerfall</a>
  </p>
</PageLayout>

<style>
  .chip-list {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 var(--space-xl);
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .chip-list li {
    background: var(--surface-cream);
    border-radius: 999px;
    padding: 0.5em 1.1em;
    font-size: 0.92rem;
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
