---
import PageLayout from '../../layouts/PageLayout.astro';
import HintBox from '../../components/ui/HintBox.astro';
import Motif from '../../components/illustrations/Motif.astro';
import { withBase } from '../../utils/url';
---

<PageLayout
  title="Überführungen national und international | Bestattungen Gorhau Würzburg"
  description="Überführungen im In- und Ausland: Bestattungen Gorhau in Würzburg organisiert die würdevolle Überführung verstorbener Menschen zuverlässig und mit allen Formalitäten."
  eyebrow="Leistungen"
  path="/leistungen/ueberfuehrungen/"
  heading="Nationale und internationale Überführungen"
  intro="Innerhalb Deutschlands oder über Landesgrenzen hinweg – wir organisieren die Überführung würdevoll und kümmern uns um alle Formalitäten."
  breadcrumbs={[
    { name: 'Leistungen', path: '/leistungen/' },
    { name: 'Überführungen', path: '/leistungen/ueberfuehrungen/' },
  ]}
>
  <figure class="page-motif">
    <Motif name="ueberfuehrung" label="Abstraktes Symbol für einen würdevollen Transport" />
  </figure>

  <div class="prose">
    <p>
      Ein Todesfall kann sich fernab des Heimatortes ereignen – auf Reisen oder in einer
      Einrichtung in einer anderen Stadt. Auch der Wunsch, eine verstorbene Person in ihr
      Heimatland zu überführen, kommt vor. In all diesen Fällen sind wir für Sie da.
    </p>
  </div>

  <h2>Inland und Ausland</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Im Inland holen wir die verstorbene Person an jedem Ort in Deutschland ab und stimmen
      Behörden, Kliniken und Einrichtungen ab. Bei Überführungen über Landesgrenzen kennen wir
      die besonderen Bestimmungen, kümmern uns um den Leichenpass und arbeiten mit
      zuverlässigen Partnern am Zielort.
    </p>
  </div>

  <h2>Was wir für Sie übernehmen</h2>
  <hr class="accent-rule" />
  <ul class="chip-list">
    <li>Abholung und Transport</li>
    <li>Abstimmung mit Behörden und Kliniken</li>
    <li>Dokumente und Genehmigungen</li>
    <li>Koordination am Zielort</li>
  </ul>

  <h2>Wann eine Überführung notwendig wird</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Immer dann, wenn Sterbeort und gewünschter Bestattungsort nicht übereinstimmen – etwa nach
      einem Krankenhausaufenthalt auswärts oder bei einer Überführung ins Heimatland. Auch
      innerhalb Würzburgs übernehmen wir die Überführung in unsere Räumlichkeiten, sobald die
      Todesbescheinigung vorliegt.
    </p>
  </div>

  <HintBox>
    Anforderungen unterscheiden sich je nach Land. Wir klären die aktuell geltenden
    Bestimmungen und den zeitlichen Ablauf für Ihren Fall.
  </HintBox>

  <div class="prose">
    <p>
      Weitere Schritte: <a href={withBase('/leistungen/formalitaeten/')}>Formalitäten</a> ·
      Bestattungsmöglichkeiten am Zielort: <a href={withBase('/bestattungsarten/')}>Bestattungsarten</a>.
    </p>
  </div>
</PageLayout>

<style>
  .chip-list {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 var(--space-xl);
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .chip-list li {
    background: var(--surface-cream);
    border-radius: 999px;
    padding: 0.5em 1.1em;
    font-size: 0.92rem;
    color: var(--brand-bordeaux-dark);
    font-weight: 600;
  }
</style>
