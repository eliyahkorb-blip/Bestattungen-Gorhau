---
import PageLayout from '../../layouts/PageLayout.astro';
import AccordionItem from '../../components/ui/AccordionItem.astro';
import HintBox from '../../components/ui/HintBox.astro';
import PhotoFigure from '../../components/ui/PhotoFigure.astro';
import StockPhoto from '../../components/ui/StockPhoto.astro';
import { withBase } from '../../utils/url';

/*
 * Überführungen, Thanatopraxie sowie Trauerfeier und Trauerdruck standen bis zum
 * UX-Rework auf eigenen Unterseiten. Sie liegen jetzt hier zusammen, bewusst in
 * wechselnden Darstellungsformen statt in gleichförmigen Karten.
 */

const trauerdruck = [
  'Traueranzeigen und Danksagungen',
  'Trauerkarten und Sterbebilder',
  'Trauerbriefe',
  'Blumenschmuck und Dekoration',
];

const formalitaeten = [
  'Beurkundung des Sterbefalls beim Standesamt',
  'Anmeldung bei Friedhof oder Krematorium',
  'Trauerfeier- und Bestattungstermin',
  'Renten- und Versicherungsanträge',
  'Abmeldungen und Anträge bei Behörden',
  'Dokumente und Genehmigungen für Überführungen',
];
---

<PageLayout
  title="Leistungen | Bestattungen Gorhau Würzburg"
  description="Überführungen, hygienische Versorgung, Thanatopraxie, Trauerfeier, Trauerdruck und Behördengänge: das Leistungsspektrum von Bestattungen Gorhau in Würzburg."
  eyebrow="Unser Leistungsspektrum"
  path="/leistungen/"
  heading="Leistungen"
  intro="Von der ersten Beratung bis zum Abschied begleiten wir Sie. Die organisatorischen und gestalterischen Aufgaben kommen aus einer Hand, damit Sie sich auf das Wesentliche konzentrieren können."
  breadcrumbs={[{ name: 'Leistungen', path: '/leistungen/' }]}
  ctaLabel="Leistungen persönlich besprechen"
  ctaHref={withBase('/kontakt/')}
>
  <h2>So arbeiten wir mit Ihnen zusammen</h2>
  <hr class="accent-rule" />
  <ol class="steps-row">
    <li>
      <span class="steps-row__num">1</span>
      <h3>Persönliches Gespräch</h3>
      <p>Telefonisch, bei uns im Haus oder bei Ihnen. Wir klären, was in Ihrer Situation gebraucht wird.</p>
    </li>
    <li>
      <span class="steps-row__num">2</span>
      <h3>Verständliche Erklärung</h3>
      <p>Keine Fachbegriffe, keine Entscheidungen unter Zeitdruck. Wir zeigen, wo Fristen wirklich bestehen.</p>
    </li>
    <li>
      <span class="steps-row__num">3</span>
      <h3>Koordination im Hintergrund</h3>
      <p>Behörden, Friedhofsverwaltung, Kirche oder Trauerredner. Wir stimmen alle Termine ab.</p>
    </li>
  </ol>

  <h2>Überführungen im In- und Ausland</h2>
  <hr class="accent-rule" />
  <div class="split">
    <div class="split__text">
      <p>
        Ein Todesfall kann sich fernab des Heimatortes ereignen, auf Reisen oder in einer
        Einrichtung in einer anderen Stadt. Im Inland holen wir die verstorbene Person an jedem
        Ort in Deutschland ab und stimmen uns mit Behörden, Kliniken und Einrichtungen ab. Bei
        Überführungen über Landesgrenzen kennen wir die besonderen Bestimmungen, kümmern uns um
        den Leichenpass und arbeiten mit zuverlässigen Partnern am Zielort. Auch innerhalb
        Würzburgs übernehmen wir die Überführung in unsere Räume, sobald die Todesbescheinigung
        vorliegt.
      </p>
    </div>
    <div class="split__media">
      <PhotoFigure
        name="fahrzeuge-vor-bestattungsinstitut"
        alt="Bestattungsfahrzeuge vor dem Bestattungsinstitut Gorhau"
        width={208}
        height={126}
        priority
      />
    </div>
  </div>

  <h2>Versorgung und Thanatopraxie</h2>
  <hr class="accent-rule" />
  <div class="split split--reverse">
    <div class="split__text">
      <p>
        Für viele Angehörige ist es wichtig, die verstorbene Person noch einmal in Ruhe sehen zu
        können. Die hygienische Versorgung, die Thanatopraxie, schafft dafür die Voraussetzung.
        Sie erfolgt in unseren Räumen durch geschultes Personal. Ziel ist ein friedvoller,
        natürlicher Anblick, keine künstliche Veränderung. Eine aufgebahrte Abschiednahme, etwa
        in unserem <a href={withBase('/abschiedsraum/')}>Abschiedsraum</a>, ist in der Regel nur
        nach einer solchen Versorgung möglich. Nötig ist sie nicht immer: Bei zeitnaher
        Beisetzung kann darauf verzichtet werden. Wir beraten Sie dazu offen und ohne Druck.
      </p>
    </div>
    <div class="split__media">
      <PhotoFigure
        name="versorgungsraum-bestattungen-gorhau"
        alt="Versorgungsraum des Bestattungsinstituts Gorhau"
        width={208}
        height={126}
      />
    </div>
  </div>

  <h2>Trauerfeier und Trauerdruck</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Ob feierlich oder schlicht, kirchlich oder frei: Wir stimmen Ort, Ablauf und Rahmen ab und
      koordinieren Feierhalle, Musik sowie Geistliche oder freie Rednerinnen und Redner. Ein
      Musikstück, ein Foto, eigene Worte von Angehörigen geben einer Feier Bedeutung. Die
      Traueranzeige ist oft die erste Nachricht vom Tod eines Angehörigen. Wir unterstützen bei
      Formulierung, Gestaltung und der Abstimmung mit Zeitungen und Druckereien.
    </p>
  </div>
  <div class="two-col">
    <ul class="plain-list">
      {trauerdruck.map((t) => <li>{t}</li>)}
    </ul>
    <StockPhoto
      name="gedenkkerzen"
      alt="Mehrere brennende Gedenkkerzen mit warmem Licht"
      sizes="(min-width: 60rem) 22rem, 92vw"
      class="two-col__photo"
    />
  </div>

  <h2>Behördengänge und Formalitäten</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Den Papierkram müssen Sie nicht selbst erledigen. Die Sterbeurkunde wird erst nach der
      Beurkundung beim Standesamt ausgestellt und für viele weitere Schritte gebraucht. Wir
      kennen diese Abläufe und sorgen dafür, dass nichts unnötig verzögert wird.
    </p>
  </div>
  <ul class="chip-list">
    {formalitaeten.map((f) => <li>{f}</li>)}
  </ul>

  <h2>Weitere Leistungen im Detail</h2>
  <hr class="accent-rule" />
  <AccordionItem title="Vollständige Übersicht ansehen">
    <p>Über die genannten Bereiche hinaus unterstützen wir Sie bei:</p>
    <ul>
      <li>Würdevolle Aufbewahrung in unseren gekühlten Räumlichkeiten</li>
      <li>Umbettungen sowie Grabbereitungen und Graböffnungen</li>
      <li>Trägergestellung</li>
      <li>Vermittlung von Trauerrednerinnen und Trauerrednern</li>
      <li>Grab- und Friedhofsdekoration, Blumenschmuck</li>
      <li>Beratung zu Grabmal und Grabpflege</li>
    </ul>
    <p>
      Sie vermissen eine bestimmte Leistung? Sprechen Sie uns an. Wir sagen Ihnen offen, ob und
      wie wir Ihnen weiterhelfen können.
    </p>
  </AccordionItem>

  <HintBox>
    Was direkt nach einem Todesfall zu tun ist, steht auf der Seite
    <a href={withBase('/im-trauerfall/')}>Im Trauerfall</a>. Wünsche für den eigenen Abschied
    lassen sich über eine <a href={withBase('/vorsorge/')}>Bestattungsvorsorge</a> festhalten.
  </HintBox>
</PageLayout>

<style>
  /* Drei Schritte nebeneinander statt untereinander: kompakter Einstieg. */
  .steps-row {
    list-style: none;
    padding: 0;
    margin-top: var(--space-lg);
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-xl);
  }
  .steps-row__num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--surface-beige);
    color: var(--brand-bordeaux-dark);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .steps-row h3 {
    margin-top: var(--space-md);
    font-size: 1.05rem;
  }
  .steps-row p {
    margin-top: var(--space-sm);
    color: var(--text-muted);
  }

  /* Text und Bild nebeneinander. Die Bildspalte ist auf die native Breite der
     Aufnahme begrenzt, damit nichts hochskaliert wird. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 208px;
    gap: var(--space-2xl);
    align-items: start;
    margin-top: var(--space-lg);
  }
  .split--reverse .split__media {
    order: -1;
  }
  .split__text p {
    max-width: 42rem;
  }
  @media (max-width: 52rem) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .split--reverse .split__media {
      order: 0;
    }
  }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    gap: var(--space-2xl);
    align-items: start;
    margin-top: var(--space-lg);
    max-width: none;
  }
  .two-col :global(.two-col__photo img) {
    border-radius: var(--radius-md);
  }
  @media (max-width: 60rem) {
    .two-col {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  .plain-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .plain-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--text-muted);
  }
  .plain-list li + li {
    margin-top: var(--space-sm);
  }
  .plain-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--brand-gold);
  }
</style>
