---
import PageLayout from '../../layouts/PageLayout.astro';
import IconFeature from '../../components/ui/IconFeature.astro';
import AccordionItem from '../../components/ui/AccordionItem.astro';
import PhotoFigure from '../../components/ui/PhotoFigure.astro';
import { withBase } from '../../utils/url';

const leistungen = [
  { icon: 'map-pin' as const, t: 'Überführungen', d: 'Würdevoll im In- und Ausland organisiert.', href: '/leistungen/ueberfuehrungen/' },
  { icon: 'embrace' as const, t: 'Thanatopraxie', d: 'Hygienische und ästhetische Versorgung.', href: '/leistungen/thanatopraxie/' },
  { icon: 'sun' as const, t: 'Trauerfeier & Trauerdruck', d: 'Trauerreden, Drucksachen, Dekoration.', href: '/leistungen/trauerfeier-und-trauerdruck/' },
  { icon: 'document' as const, t: 'Formalitäten', d: 'Behördengänge: wir nehmen Ihnen den Papierkram ab.', href: '/leistungen/formalitaeten/' },
  { icon: 'leaf' as const, t: 'Bestattungsarten', d: 'Erd-, Feuer-, See- und anonyme Bestattung.', href: '/bestattungsarten/' },
  { icon: 'clock' as const, t: 'Bestattungsvorsorge', d: 'Wünsche zu Lebzeiten festhalten.', href: '/bestattungsvorsorge/' },
];
---

<PageLayout
  title="Leistungen | Bestattungen Gorhau Würzburg"
  description="Das Leistungsspektrum von Bestattungen Gorhau in Würzburg: Überführungen, Thanatopraxie, Trauerfeier und Trauerdruck, Formalitäten sowie alle Bestattungsarten."
  eyebrow="Unser Leistungsspektrum"
  path="/leistungen/"
  heading="Leistungen"
  intro="Von der ersten Beratung bis zum würdevollen Abschied begleiten wir Sie umfassend. Alle organisatorischen und gestalterischen Aufgaben kommen aus einer Hand."
  breadcrumbs={[{ name: 'Leistungen', path: '/leistungen/' }]}
>
  <PhotoFigure
    name="sargausstellung-bestattungen-gorhau-panorama"
    alt="Sargausstellung im Bestattungsinstitut Gorhau"
    width={979}
    height={280}
    priority
    class="page-photo"
  />

  <div class="prose">
    <p>
      Als familiengeführtes Institut übernehmen wir Organisation und Behördengänge, damit Sie
      sich auf das Wesentliche konzentrieren können: den Abschied von einem geliebten Menschen.
      Jede Entscheidung treffen Sie dabei in Ruhe und nach Ihren eigenen Vorstellungen.
    </p>
    <p>
      Unsere Leistungen greifen ineinander, von der Überführung bis zur Trauerfeier. Wenn Sie
      noch nicht wissen, welche <a href={withBase('/bestattungsarten/')}>Bestattungsart</a> passt, beraten
      wir Sie dazu gern persönlich und unverbindlich.
    </p>
  </div>

  <h2>Unsere Kernleistungen im Überblick</h2>
  <hr class="accent-rule" />
  <div class="tile-grid">
    {leistungen.map((l) => <IconFeature icon={l.icon} title={l.t} text={l.d} href={l.href} />)}
  </div>

  <h2>So arbeiten wir mit Ihnen zusammen</h2>
  <hr class="accent-rule" />
  <ol class="mini-steps">
    <li>
      <strong>Persönliches Gespräch.</strong> Telefonisch, bei uns im Haus oder bei Ihnen.
      Wir klären, was in Ihrer Situation gebraucht wird.
    </li>
    <li>
      <strong>Verständliche Erklärung.</strong> Keine Fachbegriffe, keine Entscheidungen unter
      Zeitdruck. Wir zeigen, wo Fristen wirklich bestehen.
    </li>
    <li>
      <strong>Koordination im Hintergrund.</strong> Behörden, Friedhofsverwaltung, Kirche oder
      Trauerredner. Wir stimmen alle Termine ab.
    </li>
  </ol>
  <div class="prose">
    <p>
      Liegt bereits eine <a href={withBase('/bestattungsvorsorge/')}>Bestattungsvorsorge</a> vor, arbeiten
      wir auf dieser Grundlage weiter. Für die ersten Schritte nach einem Todesfall lesen Sie
      unsere Seite <a href={withBase('/im-trauerfall/')}>Im Trauerfall</a>.
    </p>
  </div>

  <h2>Weitere Leistungen im Detail</h2>
  <hr class="accent-rule" />
  <AccordionItem title="Vollständige Übersicht ansehen">
    <p>
      Über die Kernleistungen hinaus unterstützen wir Sie bei einer Vielzahl weiterer Aufgaben:
    </p>
    <ul>
      <li>Hygienische Versorgung der verstorbenen Person</li>
      <li>Würdevolle Aufbewahrung in unseren gekühlten Räumlichkeiten</li>
      <li>Umbettungen sowie Grabbereitungen und Graböffnungen</li>
      <li>Trägergestellung</li>
      <li>Vermittlung von Trauerrednerinnen und Trauerrednern</li>
      <li>Grab- und Friedhofsdekoration, Blumenschmuck</li>
      <li>Beratung zu Grabmal und Grabpflege</li>
    </ul>
    <p>
      Sie vermissen eine bestimmte Leistung? Sprechen Sie uns an. Wir sagen Ihnen offen, ob
      und wie wir Ihnen weiterhelfen können.
    </p>
  </AccordionItem>
</PageLayout>

<style>
  .tile-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin: var(--space-lg) 0 var(--space-xl);
    max-width: none;
  }
  .mini-steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    margin: var(--space-lg) 0 var(--space-lg);
    max-width: 42rem;
    display: grid;
    gap: var(--space-sm);
  }
  .mini-steps li {
    counter-increment: step;
    position: relative;
    padding: var(--space-sm) var(--space-md) var(--space-sm) 3rem;
    background: var(--surface-cream);
    border-radius: var(--radius-md);
    color: var(--text-muted);
  }
  .mini-steps li::before {
    content: counter(step);
    position: absolute;
    left: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1.6rem;
    height: 1.6rem;
    display: grid;
    place-items: center;
    background: var(--brand-bordeaux);
    color: var(--brand-white);
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .mini-steps strong {
    color: var(--brand-bordeaux-dark);
  }
</style>
