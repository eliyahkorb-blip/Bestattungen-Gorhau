---
import PageLayout from '../../layouts/PageLayout.astro';
import IconFeature from '../../components/ui/IconFeature.astro';
import HintBox from '../../components/ui/HintBox.astro';
import StockPhoto from '../../components/ui/StockPhoto.astro';
import { withBase } from '../../utils/url';

const arten = [
  { icon: 'map-pin' as const, t: 'Erdbestattung', d: 'Beisetzung des Sarges in einem Reihen- oder Wahlgrab.', href: '/bestattungsarten/erdbestattung/' },
  { icon: 'sun' as const, t: 'Feuerbestattung', d: 'Urnenbeisetzung nach der Einäscherung – vielfältige Grabformen.', href: '/bestattungsarten/feuerbestattung/' },
  { icon: 'compass' as const, t: 'Seebestattung', d: 'Beisetzung der Urne auf See – Abschied im weiten Raum.', href: '/bestattungsarten/seebestattung/' },
  { icon: 'leaf' as const, t: 'Anonyme Bestattung', d: 'Beisetzung ohne namentliche Kennzeichnung.', href: '/bestattungsarten/anonyme-bestattung/' },
];
---

<PageLayout
  title="Bestattungsarten im Überblick | Bestattungen Gorhau Würzburg"
  description="Erd-, Feuer-, See- und anonyme Bestattung: Bestattungen Gorhau in Würzburg erläutert die Bestattungsarten und hilft Ihnen, den passenden Abschied zu finden."
  eyebrow="Möglichkeiten des Abschieds"
  path="/bestattungsarten/"
  heading="Bestattungsarten"
  intro="Es gibt viele Formen, Abschied zu nehmen. Wir stellen Ihnen die gängigen Bestattungsarten vor und beraten Sie, welche zu Ihnen passt."
  breadcrumbs={[{ name: 'Bestattungsarten', path: '/bestattungsarten/' }]}
  ctaLabel="Bestattungsarten besprechen"
  ctaHref={withBase('/kontakt/')}
>
  <StockPhoto
    name="blumen-auf-sarg"
    alt="Zarter Strauß aus rosa und weißen Blüten auf einem Holzsarg"
    priority
    class="page-stock"
  />

  <div class="prose">
    <p>
      Welche Bestattungsart die richtige ist, ist eine persönliche Entscheidung – oft im Vorfeld
      per <a href={withBase('/bestattungsvorsorge/')}>Bestattungsvorsorge</a> festgelegt, sonst im Kreis der
      Angehörigen getroffen. In Deutschland gilt grundsätzlich der Friedhofszwang: Die Beisetzung
      muss auf einem zugelassenen Friedhof erfolgen, Ausnahmen bilden See- und Baumbestattung.
    </p>
  </div>

  <h2>Die vier gängigsten Bestattungsarten</h2>
  <hr class="accent-rule" />
  <div class="tile-grid">
    {arten.map((a) => <IconFeature icon={a.icon} title={a.t} text={a.d} href={a.href} />)}
  </div>

  <h2>Wie Sie die passende Bestattungsart finden</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Erd- und Feuerbestattung unterscheiden sich vor allem darin, ob im Sarg oder als Urne
      beigesetzt wird – daraus ergeben sich unterschiedliche Grabformen und Pflegeanforderungen.
      See- und anonyme Bestattung verzichten meist auf ein klassisches, gekennzeichnetes Grab.
    </p>
  </div>
  <ul class="question-list">
    <li>Wie viel Zeit soll zwischen Todesfall und Beisetzung liegen?</li>
    <li>Soll ein fester Ort der Erinnerung entstehen?</li>
    <li>Wer kümmert sich später um die Grabpflege?</li>
  </ul>
  <div class="prose">
    <p>
      Diese Fragen klären wir gern im persönlichen Gespräch – für jede Bestattungsart und die
      dazugehörigen Grabformen.
    </p>
  </div>
  <HintBox>
    Möglichkeiten und Gebühren unterscheiden sich je nach Friedhof und Gemeinde. Mehr dazu auf
    unserer Seite <a href={withBase('/friedhoefe-in-wuerzburg/')}>Friedhöfe in Würzburg</a>.
  </HintBox>
</PageLayout>

<style>
  .tile-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin: var(--space-lg) 0 var(--space-xl);
    max-width: none;
  }
  .question-list {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0;
    max-width: 40rem;
    display: grid;
    gap: var(--space-2xs);
  }
  .question-list li {
    padding: var(--space-sm) var(--space-md);
    background: var(--surface-beige);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
