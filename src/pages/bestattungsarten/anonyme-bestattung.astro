---
import PageLayout from '../../layouts/PageLayout.astro';
import HintBox from '../../components/ui/HintBox.astro';
import PhotoFigure from '../../components/ui/PhotoFigure.astro';
import StockPhoto from '../../components/ui/StockPhoto.astro';
import { withBase } from '../../utils/url';
---

<PageLayout
  title="Anonyme Bestattung | Bestattungen Gorhau Würzburg"
  description="Die anonyme Bestattung: Beisetzung ohne namentliche Kennzeichnung auf einer Gemeinschaftsfläche. Bestattungen Gorhau in Würzburg berät Sie einfühlsam."
  eyebrow="Bestattungsarten"
  path="/bestattungsarten/anonyme-bestattung/"
  heading="Anonyme Bestattung"
  intro="Bei der anonymen Bestattung wird auf einer Gemeinschaftsfläche beigesetzt, ohne Namen am Grab und ohne spätere Grabpflege. Viele Familien wählen diese Form bewusst, weil sie schlicht bleiben soll. Wir erklären Ihnen in Ruhe, was dabei möglich ist."
  breadcrumbs={[
    { name: 'Bestattungsarten', path: '/bestattungsarten/' },
    { name: 'Anonyme Bestattung', path: '/bestattungsarten/anonyme-bestattung/' },
  ]}
  ctaLabel="Bestattungsarten besprechen"
  ctaHref={withBase('/kontakt/')}
  ctaHint="Unsicher, welche Bestattungsart passt? Wir beraten Sie in Ruhe."
>
  <PhotoFigure
    name="anonyme-bestattung-rasenfeld"
    alt="Ruhige Rasenfläche einer anonymen Grabstätte"
    width={260}
    height={160}
    class="page-motif"
    priority
  />

  <div class="prose">
    <p>
      Die anonyme Bestattung erfolgt auf einer gemeinschaftlichen Grabfläche ohne individuelle
      Kennzeichnung. Häufig gewählt, wenn eine schlichte Beisetzung gewünscht ist oder die
      spätere Grabpflege keine Rolle spielen soll.
    </p>
  </div>

  <ul class="question-list">
    <li>Beisetzung ohne Namensnennung am Grab</li>
    <li>Genauer Ort in der Regel nicht bekannt</li>
    <li>Beisein der Angehörigen je nach Friedhof möglich</li>
  </ul>

  <h2>Halbanonyme Alternative</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Manche Friedhöfe bieten teilanonyme Anlagen an, bei denen der Name auf einer zentralen
      Stele vermerkt wird: ein Ort der Erinnerung, ohne dass eine eigene Grabstätte gepflegt
      werden muss.
    </p>
  </div>

  <StockPhoto
    name="sonnenlicht-ueber-wolken"
    alt="Sonnenlicht über einer weiten, ruhigen Wolkendecke"
    class="page-stock page-stock--inline"
  />

  <h2>Warum sich Menschen dafür entscheiden</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Häufige Gründe: Angehörige nicht mit der langfristigen Grabverantwortung belasten, oder die
      Vorstellung, dass Erinnerung nicht an einen festen Ort gebunden sein muss. Die Beauftragung
      und Begleitung bleibt bei uns, anders als bei einer amtlich veranlassten Bestattung ohne
      Angehörige, stets bei Ihrer Familie; nur die Grabkennzeichnung entfällt.
    </p>
  </div>

  <div class="prose">
    <p>
      Auch ohne Grabstätte ist ein würdevoller Abschied möglich, etwa durch eine Trauerfeier vor
      der Beisetzung. Möglich ist die Form sowohl als Erdbestattung als auch, häufiger, als
      Urnenbeisetzung.
    </p>
  </div>

  <HintBox>
    Wir beraten Sie einfühlsam zu den örtlichen Regelungen. Übersicht:
    <a href={withBase('/bestattungsarten/')}>Bestattungsarten</a> ·
    <a href={withBase('/friedhoefe-in-wuerzburg/')}>Friedhöfe in Würzburg</a>.
  </HintBox>
</PageLayout>

<style>
  .question-list {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 var(--space-xl);
    max-width: 40rem;
    display: grid;
    gap: var(--space-2xs);
  }
  .question-list li {
    padding: var(--space-sm) var(--space-md);
    background: var(--surface-beige);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
