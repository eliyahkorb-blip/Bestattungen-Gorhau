---
import PageLayout from '../../layouts/PageLayout.astro';
import HintBox from '../../components/ui/HintBox.astro';
import Motif from '../../components/illustrations/Motif.astro';
import PhotoFigure from '../../components/ui/PhotoFigure.astro';
import { withBase } from '../../utils/url';
---

<PageLayout
  title="Erdbestattung | Bestattungen Gorhau Würzburg"
  description="Die Erdbestattung: klassische Beisetzung im Sarg als Reihen- oder Wahlgrab. Bestattungen Gorhau in Würzburg begleitet Sie bei allen Schritten und Formalitäten."
  eyebrow="Bestattungsarten"
  path="/bestattungsarten/erdbestattung/"
  heading="Erdbestattung"
  intro="Bei der Erdbestattung wird der Sarg in einem Grab auf dem Friedhof beigesetzt, mit einem festen Ort der Erinnerung."
  breadcrumbs={[
    { name: 'Bestattungsarten', path: '/bestattungsarten/' },
    { name: 'Erdbestattung', path: '/bestattungsarten/erdbestattung/' },
  ]}
  ctaLabel="Bestattungsarten besprechen"
  ctaHref={withBase('/kontakt/')}
  ctaHint="Unsicher, welche Bestattungsart passt? Wir beraten Sie in Ruhe."
>
  <PhotoFigure
    name="erdbestattung-dekoration"
    alt="Grabstätte mit Blumengestecken und Kranzschmuck bei einer Erdbestattung"
    width={260}
    height={160}
    class="page-motif"
    priority
  />

  <div class="prose">
    <p>
      Die Erdbestattung ist die klassische Bestattungsform. Der Sarg wird auf einem Friedhof
      beigesetzt; die Grabstätte bietet einen dauerhaften Ort der Erinnerung und der Grabpflege.
    </p>
  </div>

  <div class="fact-grid">
    <div class="fact-card">
      <h3>Reihengrab</h3>
      <p>Wird der Reihe nach vergeben, genutzt für die Dauer der Ruhezeit.</p>
    </div>
    <div class="fact-card">
      <h3>Wahlgrab</h3>
      <p>Frei wählbar und verlängerbar, oft als Familiengrab genutzt.</p>
    </div>
  </div>

  <h2>Ablauf und Sargauswahl</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Nach der Wahl der Grabstätte stimmen wir Termin und Ablauf mit dem Friedhof ab. Die
      Trauerfeier findet in der Friedhofskapelle, einer Kirche oder frei gestaltet statt, bevor
      der Sarg zur Grabstätte getragen wird. Für den Sarg stehen verschiedene Modelle und
      Holzarten zur Wahl. Wir beraten Sie zu Gestaltung und den Maßen der Grabstätte.
    </p>
  </div>

  <figure class="page-motif page-motif--inline">
    <Motif name="friedhoefe" label="Friedhofsweg mit Bäumen" />
  </figure>

  <h2>Grabpflege als Ort der Erinnerung</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Anders als bei pflegefreien Anlagen übernehmen Angehörige bei einem Reihen- oder Wahlgrab
      meist selbst die Pflege, oder sie übernimmt ein Friedhofsgärtner. Für viele ist das zugleich ein
      Trost: ein Ort, der besucht und gepflegt werden kann.
    </p>
  </div>

  <HintBox>
    Ruhezeiten, Grabarten und Gebühren richten sich nach der jeweiligen Friedhofssatzung und
    können unterschiedlich sein. Mehr dazu auf unserer Seite
    <a href={withBase('/friedhoefe-in-wuerzburg/')}>Friedhöfe in Würzburg</a>.
  </HintBox>

  <p class="related-link">
    Verwandtes Thema: <a href={withBase('/bestattungsarten/')}>Alle Bestattungsarten im Überblick</a>
  </p>
</PageLayout>

<style>
  .fact-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    margin: var(--space-lg) 0 var(--space-xl);
    max-width: 40rem;
  }
  .fact-card {
    background: var(--surface-cream);
    border-radius: var(--radius-md);
    padding: var(--space-md) var(--space-lg);
  }
  .fact-card h3 {
    font-size: 1.05rem;
    color: var(--brand-bordeaux-dark);
    margin-bottom: 0.2rem;
  }
  .fact-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
</style>
