---
import PageLayout from '../../layouts/PageLayout.astro';
import HintBox from '../../components/ui/HintBox.astro';
import { withBase } from '../../utils/url';
---

<PageLayout
  title="Feuerbestattung | Bestattungen Gorhau Würzburg"
  description="Die Feuerbestattung: Beisetzung der Urne nach der Einäscherung mit vielfältigen Grabformen. Bestattungen Gorhau in Würzburg berät Sie zu allen Möglichkeiten."
  eyebrow="Bestattungsarten"
  path="/bestattungsarten/feuerbestattung/"
  heading="Feuerbestattung"
  intro="Nach der Einäscherung wird die Urne beigesetzt – mit einer größeren Vielfalt an Grabformen als bei der Erdbestattung."
  breadcrumbs={[
    { name: 'Bestattungsarten', path: '/bestattungsarten/' },
    { name: 'Feuerbestattung', path: '/bestattungsarten/feuerbestattung/' },
  ]}
>
  <div class="prose">
    <p>
      Die Feuerbestattung gehört heute zu den am häufigsten gewählten Bestattungsformen. Nach der
      Einäscherung im Krematorium stehen verschiedene Grabarten für die Urne zur Verfügung.
    </p>
  </div>

  <h2>Beisetzungsformen der Urne</h2>
  <hr class="accent-rule" />
  <ul class="chip-list">
    <li>Urnenreihen- und Urnenwahlgrab</li>
    <li>Urnengarten und Gemeinschaftsanlagen</li>
    <li>Baumbestattung</li>
    <li><a href={withBase('/bestattungsarten/seebestattung/')}>Seebestattung</a></li>
    <li><a href={withBase('/bestattungsarten/anonyme-bestattung/')}>Anonyme Beisetzung</a></li>
  </ul>

  <h2>Ablauf und rechtliche Voraussetzung</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Neben der Todesbescheinigung ist für eine Feuerbestattung eine zweite, unabhängige
      ärztliche Leichenschau erforderlich – diese Formalität übernehmen wir für Sie. Auf Wunsch
      ist vor der Einäscherung eine Trauerfeier oder ein Abschied am Sarg möglich; die Urne wird
      erst danach beigesetzt.
    </p>
  </div>

  <h2>Warum viele sich dafür entscheiden</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Die Feuerbestattung bietet mehr Freiheit bei der Grabwahl: von der klassischen
      Urnengrabstätte über pflegearme Gemeinschaftsanlagen bis zur naturnahen Baumbestattung. Bei
      Urnengärten übernimmt oft die Friedhofsverwaltung die Pflege – eine Erleichterung für
      Angehörige, die selbst keine dauerhafte Grabpflege leisten möchten.
    </p>
  </div>

  <HintBox>
    Beisetzungsformen und Gebühren hängen vom jeweiligen Friedhof ab. Allgemeine Hinweise finden
    Sie auf unserer Seite <a href={withBase('/friedhoefe-in-wuerzburg/')}>Friedhöfe in Würzburg</a>.
  </HintBox>
</PageLayout>

<style>
  .chip-list {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 var(--space-xl);
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  .chip-list li {
    background: var(--surface-cream);
    border-radius: 999px;
    padding: 0.5em 1.1em;
    font-size: 0.92rem;
    color: var(--brand-bordeaux-dark);
    font-weight: 600;
  }
  .chip-list a {
    color: inherit;
    text-decoration: none;
  }
  .chip-list a:hover {
    text-decoration: underline;
  }
</style>
