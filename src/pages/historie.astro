---
import PageLayout from '../layouts/PageLayout.astro';
import PhotoFigure from '../components/ui/PhotoFigure.astro';
import { withBase } from '../utils/url';

const milestones = [
  { year: '1970', text: 'Gründung des Bestattungsinstituts durch Manfred und Ingrid Gorhau. Eröffnung am 11. Mai 1970.' },
  { year: '1980', text: 'Umzug in die Reuterstraße 2 nach Würzburg-Heidingsfeld, dem bis heute bestehenden Standort.' },
  { year: '2004', text: 'Einrichtung eines hauseigenen Abschiedsraums. Eines der ersten Häuser in Würzburg, das Angehörigen bewusst „Raum und Zeit“ für den Abschied bietet.' },
  { year: 'Heute', text: 'Fortführung des Unternehmens als familiengeführtes Institut unter Inhaber Thomas Gorhau: der Tradition verpflichtet, für die Gegenwart gerüstet.' },
];
---

<PageLayout
  title="Unsere Historie seit 1970 | Bestattungen Gorhau Würzburg"
  description="Die Geschichte des Bestattungsinstituts Gorhau: gegründet 1970, seit 1980 in Würzburg-Heidingsfeld, seit 2004 mit hauseigenem Abschiedsraum. Ein Familienunternehmen."
  eyebrow="Unsere Geschichte"
  path="/historie/"
  heading="Unternehmensgeschichte seit 1970"
  intro="Aus einem Familienbetrieb ist über die Jahrzehnte ein fester Bestandteil der Würzburger Bestattungskultur geworden. Ein kurzer Blick auf unsere Geschichte."
  breadcrumbs={[{ name: 'Historie', path: '/historie/' }]}
>
  <PhotoFigure
    name="bestattungen-gorhau-historische-fahrzeuge-panorama"
    alt="Historische Bestattungsfahrzeuge des Instituts Gorhau"
    width={979}
    height={280}
    priority
    class="page-photo"
  />

  <div class="prose">
    <p>
      Manche Unternehmen lassen sich in wenigen Sätzen beschreiben. Bei einem Familienbetrieb,
      der seit über fünfzig Jahren besteht, steckt in jedem Jahrzehnt eine eigene Geschichte.
      Die folgende Zeitleiste zeigt die wichtigsten Stationen unseres Instituts, von der
      Gründung 1970 bis heute.
    </p>
  </div>

  <h2>Stationen unserer Geschichte</h2>
  <hr class="accent-rule" />
  <ol class="timeline">
    {
      milestones.map((m) => (
        <li class="timeline__item">
          <span class="timeline__year">{m.year}</span>
          <p>{m.text}</p>
        </li>
      ))
    }
  </ol>

  <PhotoFigure
    name="historischer-bestattungswagen-gorhau-panorama"
    alt="Historischer Bestattungswagen des Instituts Gorhau"
    width={979}
    height={280}
    class="page-photo page-photo--inline"
  />

  <div class="prose">
    <p>
      Was 1970 begann, tragen wir bis heute weiter: die Überzeugung, dass jeder Mensch einen
      würdevollen Abschied verdient. Die Haltung „Zuhören, beraten, begleiten“ ist dabei mehr als
      ein Leitspruch. Sie zeigt sich etwa in der Einrichtung des Abschiedsraums 2004.
    </p>
  </div>

  <PhotoFigure
    name="bestattungen-gorhau-historie-bildleiste"
    alt="Historische Ansichten früherer Filialen und Fahrzeuge des Instituts Gorhau"
    width={830}
    height={99}
    class="page-photo page-photo--inline"
  />
  <PhotoFigure
    name="thomas-und-manfred-gorhau-historisch"
    alt="Thomas und Manfred Gorhau, historische Aufnahme"
    width={208}
    height={126}
    class="page-motif page-motif--inline"
  />

  <div class="prose">
    <p>
      Mehr über unser heutiges Leistungsspektrum erfahren Sie auf der Seite
      <a href={withBase('/ueber-uns/')}>Über uns</a>, mehr über unseren
      <a href={withBase('/abschiedsraum/')}>Abschiedsraum</a> auf der entsprechenden Seite.
    </p>
    <p class="src-note">
      Einzelne historische Angaben stammen aus öffentlich zugänglichen Unternehmensprofilen
      und den bisherigen Website-Inhalten. Weitere Aufnahmen finden Sie in unserer
      <a href={withBase('/ueber-uns/')}>Galerie</a> und in der <a href={withBase('/mediathek/')}>Mediathek</a>.
    </p>
  </div>
</PageLayout>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
    max-width: 44rem;
    border-left: 3px solid var(--brand-gold);
  }
  .timeline__item {
    padding: 0 0 var(--space-lg) var(--space-lg);
    position: relative;
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    left: -0.6rem;
    top: 0.3rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--brand-bordeaux);
  }
  .timeline__year {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--brand-bordeaux-dark);
    margin-bottom: var(--space-2xs);
  }
  .timeline__item p {
    margin: 0;
    color: var(--text-muted);
  }
  .src-note {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
