---
import PageLayout from '../layouts/PageLayout.astro';
import HintBox from '../components/ui/HintBox.astro';
import Quote from '../components/ui/Quote.astro';
import Motif from '../components/illustrations/Motif.astro';
import { withBase } from '../utils/url';
---

<PageLayout
  title="Bestattungsvorsorge in Würzburg | Bestattungen Gorhau"
  description="Bestattungsvorsorge bei Bestattungen Gorhau in Würzburg: Regeln Sie Ihre Wünsche zu Lebzeiten und entlasten Sie Ihre Angehörigen. Vorsorgevertrag und Beratung."
  eyebrow="Selbstbestimmt vorsorgen"
  path="/bestattungsvorsorge/"
  heading="Bestattungsvorsorge"
  intro="Mit einer Bestattungsvorsorge legen Sie zu Lebzeiten fest, wie Ihr Abschied gestaltet werden soll – und entlasten Ihre Angehörigen in einer schweren Zeit."
  breadcrumbs={[{ name: 'Bestattungsvorsorge', path: '/bestattungsvorsorge/' }]}
  ctaLabel="Vorsorgegespräch vereinbaren"
  ctaHref={withBase('/kontakt/')}
>
  <figure class="page-motif">
    <Motif name="vorsorge" label="Zwei Sprechblasen als Sinnbild eines vertrauensvollen Gesprächs" />
  </figure>

  <div class="prose">
    <p>
      Ein Todesfall trifft Angehörige oft unerwartet – selbst wenn er absehbar war. Eine Vorsorge
      nimmt ihnen viele Entscheidungen ab, weil die wesentlichen Fragen bereits geklärt sind.
    </p>
  </div>

  <ul class="benefit-list">
    <li>Sie bestimmen selbst, wie Ihr Abschied gestaltet wird</li>
    <li>Angehörige werden organisatorisch und finanziell entlastet</li>
    <li>Ihre Wünsche sind schriftlich und verbindlich hinterlegt</li>
  </ul>

  <h2>Ihre Wünsche festhalten</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Im Vorsorgegespräch – bei uns oder bei Ihnen zu Hause – halten wir Bestattungsart, Ort der
      Trauerfeier, Musik und weitere persönliche Wünsche fest. Nichts ist endgültig: Eine
      getroffene Vorsorge kann jederzeit angepasst werden.
    </p>
  </div>

  <h2>Finanziell absichern</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Für die finanzielle Seite gibt es zwei gängige Modelle: einen Vorsorgevertrag mit
      treuhänderisch verwaltetem Betrag oder eine Sterbegeldversicherung mit monatlichen
      Beiträgen. Beide unterscheiden sich in Flexibilität und Laufzeit – wir erläutern Ihnen die
      Unterschiede ohne ein bestimmtes Produkt aufzudrängen.
    </p>
  </div>

  <HintBox>
    Konkrete Konditionen richten sich nach dem jeweiligen Anbieter. Wir nennen Ihnen die zum
    Gesprächszeitpunkt geltenden Möglichkeiten – unverbindlich.
  </HintBox>

  <Quote text="Vorsorgen heißt nicht, an das Ende zu denken – sondern der eigenen Familie Klarheit zu schenken." />

  <p class="related-link">
    Verwandte Themen: <a href={withBase('/bestattungsarten/')}>Bestattungsarten</a> ·
    <a href={withBase('/abschiedsraum/')}>Abschiedsraum</a>
  </p>
</PageLayout>

<style>
  .benefit-list {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0 var(--space-xl);
    max-width: 40rem;
    display: grid;
    gap: var(--space-2xs);
  }
  .benefit-list li {
    padding: var(--space-sm) var(--space-md);
    background: var(--surface-beige);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-weight: 600;
  }
</style>
