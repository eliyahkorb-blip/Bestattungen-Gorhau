---
import PageLayout from '../../layouts/PageLayout.astro';
import Motif from '../../components/illustrations/Motif.astro';
import { withBase } from '../../utils/url';

const themen = [
  { name: 'gebaeude' as const, t: 'Unser Haus', href: '/kontakt/' },
  { name: 'abschiedsraum' as const, t: 'Abschiedsraum', href: '/abschiedsraum/' },
  { name: 'historie' as const, t: 'Historie seit 1970', href: '/ueber-uns/historie/' },
];
---

<PageLayout
  title="Galerie | Bestattungen Gorhau Würzburg"
  description="Einblicke in Bestattungen Gorhau in Würzburg: unser Haus, der Abschiedsraum und die Unternehmensgeschichte seit 1970."
  eyebrow="Einblicke"
  path="/ueber-uns/galerie/"
  heading="Galerie"
  intro="Ein erster Eindruck von unserem Institut, dem Abschiedsraum und unserer Geschichte."
  breadcrumbs={[
    { name: 'Über uns', path: '/ueber-uns/' },
    { name: 'Galerie', path: '/ueber-uns/galerie/' },
  ]}
  ctaLabel="Persönliche Beratung anfragen"
  ctaHref={withBase('/kontakt/')}
>
  <ul class="theme-grid">
    {
      themen.map((th) => (
        <li>
          <a class="theme-tile" href={withBase(th.href)}>
            <Motif name={th.name} label={th.t} class="theme-tile__img" />
            <h2 class="theme-tile__title">{th.t}</h2>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="prose gallery-outro">
    <p>
      Ein historisches Dokument aus unserem Firmenarchiv – die Anzeige zum Tag der offenen Tür
      2009 – finden Sie in der <a href={withBase('/mediathek/')}>Mediathek</a>.
    </p>
  </div>
</PageLayout>

<style>
  .theme-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0 0;
    max-width: none;
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .theme-tile {
    display: block;
    background: var(--surface-cream);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .theme-tile:hover {
    border-color: var(--brand-gold);
    transform: translateY(-2px);
  }
  .theme-tile :global(.theme-tile__img) {
    max-width: 9rem;
    margin: 0 auto var(--space-sm);
  }
  .theme-tile__title {
    font-size: 1.1rem;
    text-align: center;
    margin: 0;
  }
  .gallery-outro {
    margin-top: var(--space-xl);
  }
</style>
