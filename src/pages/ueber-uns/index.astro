---
import PageLayout from '../../layouts/PageLayout.astro';
import IconFeature from '../../components/ui/IconFeature.astro';
import { company } from '../../data/company';
import { withBase } from '../../utils/url';

const links = [
  { icon: 'history' as const, title: 'Historie seit 1970', text: 'Die Stationen unserer Geschichte.', href: '/ueber-uns/historie/' },
  { icon: 'film' as const, title: 'Galerie', text: 'Aktuelle und historische Bilder.', href: '/ueber-uns/galerie/' },
  { icon: 'window-light' as const, title: 'Abschiedsraum', text: 'Unser hauseigener Raum für den Abschied.', href: '/abschiedsraum/' },
  { icon: 'film' as const, title: 'Mediathek', text: 'Imagefilm und historische Aufnahmen.', href: '/mediathek/' },
];
---

<PageLayout
  title="Über uns – Familienunternehmen seit 1970 | Bestattungen Gorhau Würzburg"
  description="Bestattungen Gorhau in Würzburg-Heidingsfeld: ein Familienunternehmen seit 1970. Zuhören, beraten, begleiten – persönliche Begleitung mit fachlicher Qualifikation."
  eyebrow="Wer wir sind"
  path="/ueber-uns/"
  heading="Ein Familienunternehmen seit 1970"
  intro="Seit über fünf Jahrzehnten begleiten wir Menschen aus Würzburg und der Region in Zeiten der Trauer."
  breadcrumbs={[{ name: 'Über uns', path: '/ueber-uns/' }]}
>
  <div class="prose">
    <p>
      1970 gegründet, sind wir seit 1980 in der Reuterstraße in Würzburg-Heidingsfeld zu Hause.
      Über die Jahrzehnte ist Vertrauen gewachsen – häufig über mehrere Generationen einer
      Familie hinweg.
    </p>
  </div>

  <h2>Unsere Haltung: Zuhören, beraten, begleiten</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Wir hören zunächst zu, um zu verstehen, was Ihnen wichtig ist. Wir beraten Sie in aller
      Ruhe zu den Möglichkeiten. Und wir begleiten Sie – vom ersten Anruf bis über die
      Bestattung hinaus.
    </p>
  </div>

  <h2>Persönlich, regional, qualifiziert</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Als inhabergeführtes Institut sind wir keine anonyme Kette, sondern feste Ansprechpartner
      vor Ort. Eine würdevolle Bestattung erfordert Sorgfalt und Können – wir verbinden
      handwerkliche Qualifikation mit menschlicher Nähe und bilden uns fachlich stetig weiter.
      Viele Familien, die wir heute betreuen, kannten unser Institut bereits durch frühere
      Bestattungen in ihrem Umfeld.
    </p>
    <p>
      Von der ersten Beratung bis zur Bestattungsvorsorge bieten wir alle Leistungen aus einer
      Hand – die vollständige Übersicht finden Sie auf der Seite
      <a href={withBase('/leistungen/')}>Leistungen</a>.
    </p>
  </div>

  <h2>Mehr über uns</h2>
  <hr class="accent-rule" />
  <div class="tile-grid">
    {links.map((l) => <IconFeature icon={l.icon} title={l.title} text={l.text} href={l.href} />)}
  </div>

  <div class="prose">
    <p>
      Sie erreichen uns unter <a href={`tel:${company.phoneRaw}`}>{company.phone}</a> oder per
      E-Mail an <a href={`mailto:${company.email}`}>{company.email}</a>.
    </p>
  </div>
</PageLayout>

<style>
  .tile-grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    margin: var(--space-lg) 0 var(--space-xl);
    max-width: none;
  }
</style>
