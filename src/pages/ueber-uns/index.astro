---
import PageLayout from '../../layouts/PageLayout.astro';
import PhotoFigure from '../../components/ui/PhotoFigure.astro';
import StockPhoto from '../../components/ui/StockPhoto.astro';
import { company } from '../../data/company';
import { withBase } from '../../utils/url';

/*
 * Die frühere Galerie-Unterseite ist hier integriert. Es sind ausschließlich
 * echte Aufnahmen des Unternehmens, die nur als 208x126-Thumbnails vorliegen und
 * deshalb bewusst klein und ohne Hochskalierung gezeigt werden.
 */
const fotos = [
  { name: 'bestattungsinstitut-gorhau-aussenansicht-panorama', alt: 'Außenansicht des Bestattungsinstituts Gorhau in der Reuterstraße, Würzburg-Heidingsfeld' },
  { name: 'abschiedsraum-bestattungen-gorhau-panorama', alt: 'Abschiedsraum des Bestattungsinstituts Gorhau' },
  { name: 'beratungsbuero-bestattungen-gorhau', alt: 'Beratungsbüro im Bestattungsinstitut Gorhau' },
  { name: 'versorgungsraum-bestattungen-gorhau', alt: 'Versorgungsraum des Bestattungsinstituts Gorhau' },
  { name: 'sargausstellung-detail-1', alt: 'Detailansicht der Sargausstellung' },
  { name: 'sargausstellung-detail-2', alt: 'Weitere Detailansicht der Sargausstellung' },
  { name: 'fahrzeuge-vor-bestattungsinstitut', alt: 'Bestattungsfahrzeuge vor dem Bestattungsinstitut Gorhau' },
  { name: 'bestattungsinstitut-gorhau-innenhof-panorama-2', alt: 'Innenhof des Bestattungsinstituts Gorhau in Würzburg-Heidingsfeld' },
  { name: 'historisches-gebaeude-reuterstrasse', alt: 'Historische Ansicht des Gebäudes in der Reuterstraße' },
  { name: 'filiale-erthalstrasse-wuerzburg', alt: 'Frühere Filiale des Bestattungsinstituts Gorhau in der Erthalstraße' },
  { name: 'historische-filiale-muenzstrasse', alt: 'Historische Filiale des Bestattungsinstituts in der Münzstraße' },
  { name: 'historische-filiale-uffenheim', alt: 'Historische Filiale des Bestattungsinstituts in Uffenheim' },
];
---

<PageLayout
  title="Über uns: Familienbetrieb seit 1970 | Gorhau"
  description="Bestattungen Gorhau in Würzburg-Heidingsfeld: ein Familienunternehmen seit 1970. Zuhören, beraten, begleiten. Persönliche Begleitung mit fachlicher Qualifikation."
  eyebrow="Wer wir sind"
  path="/ueber-uns/"
  heading="Ein Familienunternehmen seit 1970"
  intro="Seit über fünf Jahrzehnten begleiten wir Menschen aus Würzburg und der Region in Zeiten der Trauer."
  breadcrumbs={[{ name: 'Über uns', path: '/ueber-uns/' }]}
>
  <PhotoFigure
    name="bestattungsinstitut-gorhau-innenhof-panorama-1"
    alt="Innenhof des Bestattungsinstituts Gorhau in Würzburg-Heidingsfeld"
    width={979}
    height={280}
    priority
    class="page-photo"
  />

  <div class="prose">
    <p>
      1970 gegründet, sind wir seit 1980 in der Reuterstraße in Würzburg-Heidingsfeld zu Hause.
      Über die Jahrzehnte ist Vertrauen gewachsen, häufig über mehrere Generationen einer
      Familie hinweg.
    </p>
  </div>

  <h2>Unsere Haltung: Zuhören, beraten, begleiten</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Wir hören zunächst zu, um zu verstehen, was Ihnen wichtig ist. Wir beraten Sie in aller
      Ruhe zu den Möglichkeiten. Und wir begleiten Sie, vom ersten Anruf bis über die
      Bestattung hinaus.
    </p>
  </div>

  <h2>Persönlich, regional, qualifiziert</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Als inhabergeführtes Institut sind wir keine anonyme Kette, sondern feste Ansprechpartner
      vor Ort. Eine würdevolle Bestattung erfordert Sorgfalt und Können. Wir verbinden
      handwerkliche Qualifikation mit menschlicher Nähe und bilden uns fachlich stetig weiter.
      Viele Familien, die wir heute betreuen, kannten unser Institut bereits durch frühere
      Bestattungen in ihrem Umfeld.
    </p>
    <p>
      Von der ersten Beratung bis zur Bestattungsvorsorge bieten wir alle Leistungen aus einer
      Hand. Die vollständige Übersicht finden Sie auf der Seite
      <a href={withBase('/leistungen/')}>Leistungen</a>.
    </p>
  </div>

  <StockPhoto
    name="wuerzburg-kaeppele-herbst"
    alt="Herbstlicher Blick auf einen Würzburger Hang mit Kirche und Weinbergen"
    caption="Würzburg, die Stadt, in der wir seit 1970 zu Hause sind."
    class="page-stock page-stock--inline"
  />

  <h2>Einblicke in unser Haus</h2>
  <hr class="accent-rule" />
  <div class="prose">
    <p>
      Beratungsbüro, Abschiedsraum, Sargausstellung und frühere Standorte: Aufnahmen aus
      unserem Haus und aus dem Firmenarchiv.
    </p>
  </div>
  <ul class="photo-grid">
    {
      fotos.map((f) => (
        <li>
          <PhotoFigure name={f.name} alt={f.alt} width={208} height={126} class="photo-grid__item" />
        </li>
      ))
    }
  </ul>

  <div class="prose">
    <p>
      Mehr zur Geschichte des Hauses steht auf der Seite
      <a href={withBase('/historie/')}>Historie</a>, historisches Pressematerial in der
      <a href={withBase('/mediathek/')}>Mediathek</a>. Sie erreichen uns unter
      <a href={`tel:${company.phoneRaw}`}>{company.phone}</a> oder per E-Mail an
      <a href={`mailto:${company.email}`}>{company.email}</a>.
    </p>
  </div>
</PageLayout>

<style>
  .photo-grid {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0 var(--space-xl);
    max-width: none;
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(auto-fit, minmax(208px, 1fr));
  }
  .photo-grid :global(.photo-grid__item) {
    margin: 0;
  }
  .photo-grid :global(.photo-grid__item img) {
    width: 100%;
    height: auto;
  }
</style>
