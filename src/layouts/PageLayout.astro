---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageCta from '../components/ui/PageCta.astro';
import { breadcrumbLd } from '../data/jsonld';
import { withBase } from '../utils/url';
import type { Crumb } from '../components/Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  intro?: string;
  eyebrow?: string;
  breadcrumbs: Crumb[];
  cta?: boolean;
  /** Zurückhaltender Abschluss-CTA (ein Link statt vollem Bordeaux-Panel). */
  ctaLabel?: string;
  ctaHref?: string;
  ctaHint?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  heading,
  intro,
  eyebrow,
  breadcrumbs,
  cta = true,
  ctaLabel = 'Persönliche Beratung anfragen',
  ctaHref = withBase('/kontakt/'),
  ctaHint,
  jsonLd = [],
} = Astro.props;

const crumbLd = breadcrumbLd([
  { name: 'Start', path: '/' },
  ...breadcrumbs,
]);
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={[crumbLd, ...jsonLd]}
>
  <Breadcrumbs slot="breadcrumbs" items={breadcrumbs} />

  <div class="page-head">
    <div class="container">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{heading}</h1>
      {intro && <p class="lead">{intro}</p>}
    </div>
  </div>

  <div class="section section--white">
    <div class="container">
      <slot />
    </div>
  </div>

  {
    cta && (
      <div class="section section--dark page-close">
        <div class="container">
          <PageCta label={ctaLabel} href={ctaHref} hint={ctaHint} onBrand />
        </div>
      </div>
    )
  }
</BaseLayout>

<style>
  /* Warmes Band über dem Inhalt: rahmt die weiße Lesefläche und nimmt der
     Seite die klinische Wirkung, ohne Text auf farbigen Grund zu setzen. */
  .page-head {
    background: linear-gradient(180deg, var(--surface-beige), var(--surface-cream));
    padding-block: var(--space-2xl) var(--space-xl);
    border-bottom: 1px solid var(--border-subtle);
  }
  .page-head .lead {
    margin-top: var(--space-lg);
    max-width: 46rem;
  }
  /* Ein kompaktes Markenband als Seitenabschluss: der einzige große
     Bordeaux-Moment je Unterseite, bewusst ohne langen Text darauf. */
  .page-close {
    padding-block: var(--space-2xl);
  }
</style>
