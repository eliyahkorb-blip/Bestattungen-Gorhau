---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBar from '../components/ContactBar.astro';
import { websiteLd, localBusinessLd, organizationLd, webPageLd } from '../data/jsonld';
import { withBase } from '../utils/url';

export interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  includeBusinessLd?: boolean;
}

const {
  title,
  description,
  path,
  noindex = false,
  jsonLd = [],
  includeBusinessLd = false,
} = Astro.props;

const baseLd = includeBusinessLd
  ? [websiteLd(), localBusinessLd(), organizationLd()]
  : [webPageLd(title, description, path)];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#882020" />
    {/*
      Die zwei Schnitte des ersten Viewports vorladen, damit sie die kurze
      Wartezeit von font-display: optional zuverlaessig einhalten.
    */}
    <link
      rel="preload"
      href={withBase('/fonts/source-sans-3-latin-400-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase('/fonts/source-serif-4-latin-700-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <Seo
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      jsonLd={[...baseLd, ...jsonLd]}
    />
    <slot name="head" />
  </head>
  <body>
    <a href="#hauptinhalt" class="skip-link">Zum Inhalt springen</a>
    <Header />
    <slot name="breadcrumbs" />
    <main id="hauptinhalt">
      <slot />
    </main>
    <Footer />
    <ContactBar />
  </body>
</html>
