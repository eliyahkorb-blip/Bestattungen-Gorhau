---
/*
 * Logo-Komponente.
 * Sobald das echte Gorhau-Logo per Ingest bereitgestellt wurde
 * (public/img/logo.png + public/img/logo-meta.json), wird es automatisch
 * verwendet – das Markendesign wird dabei NICHT verändert.
 * Solange keine Originaldatei vorliegt, dient eine zurückhaltende typografische
 * Platzhalter-Wortmarke als Stand-in (kein Redesign der Marke).
 * Siehe docs/LOGO-SOURCE.md und scripts/ingest-assets.py.
 */
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  variant?: 'default' | 'light';
}
const { variant = 'default' } = Astro.props;

// Echtes Logo erkennen (Build-Zeit, statisch)
const metaPath = path.resolve('public/img/logo-meta.json');
let realLogo: {
  width: number;
  height: number;
  src: string;
  webp: string;
  srcset: string;
  srcsetWebp?: string;
} | null = null;
try {
  if (fs.existsSync(metaPath)) {
    realLogo = JSON.parse(fs.readFileSync(metaPath, 'utf8'));
  }
} catch {
  realLogo = null;
}

// Anzeigehöhe im Header (per CSS); width/height-Attribute = intrinsische Maße
// → exakt korrektes Seitenverhältnis, kein CLS, keine Aspect-Ratio-Warnung.
const targetH = 54;
const displayW = realLogo ? Math.round((realLogo.width / realLogo.height) * targetH) : 0;

const wordColor = variant === 'light' ? '#fbf7f0' : '#521720';
const subColor = variant === 'light' ? '#e3d9c8' : '#5c544c';
const gold = '#b8933d';
---

{
  realLogo ? (
    <picture class="logo-pic">
      {realLogo.srcsetWebp && (
        <source type="image/webp" srcset={realLogo.srcsetWebp} sizes={`${displayW}px`} />
      )}
      <img
        class="logo-img"
        src={realLogo.src}
        srcset={realLogo.srcset}
        sizes={`${displayW}px`}
        width={realLogo.width}
        height={realLogo.height}
        alt="Bestattungen Gorhau – Bestattungs- und Überführungs-Institut, Würzburg-Heidingsfeld"
        decoding="async"
      />
    </picture>
  ) : (
    <span class="logo" aria-hidden="false">
      <svg
        class="logo__mark"
        width="34"
        height="42"
        viewBox="0 0 34 42"
        aria-hidden="true"
        focusable="false"
      >
        <rect x="14.5" y="2" width="5" height="38" rx="1" fill={gold} />
        <rect x="4" y="12" width="26" height="5" rx="1" fill={gold} />
      </svg>
      <span class="logo__text">
        <span class="logo__word" style={`color:${wordColor}`}>
          GORHAU
        </span>
        <span class="logo__sub" style={`color:${subColor}`}>
          Bestattungen · seit 1970
        </span>
      </span>
    </span>
  )
}

<style>
  .logo-pic {
    display: block;
  }
  .logo-img {
    height: 54px;
    width: auto;
    display: block;
  }
  @media (max-width: 480px) {
    .logo-img {
      height: 44px;
    }
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    line-height: 1.05;
  }
  .logo__mark {
    flex: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
  }
  .logo__word {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.06em;
  }
  .logo__sub {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
