---
/* Sanfter organischer Übergang zwischen zwei Sektionen (statt harter Kante). */
export interface Props {
  fill?: string;
  flip?: boolean;
}
const { fill = 'var(--surface-cream)', flip = false } = Astro.props;
---

<div class={`wave-divider ${flip ? 'wave-divider--flip' : ''}`} aria-hidden="true">
  <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
    <path
      d="M0 30 C 200 60 400 0 600 20 C 800 40 1000 10 1200 30 L1200 60 L0 60 Z"
      fill={fill}
    ></path>
  </svg>
</div>

<style>
  .wave-divider {
    display: block;
    line-height: 0;
    margin-top: -1px;
  }
  .wave-divider svg {
    width: 100%;
    height: 2.5rem;
    display: block;
  }
  .wave-divider--flip {
    transform: scaleY(-1);
  }
</style>
