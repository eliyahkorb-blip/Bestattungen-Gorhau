---
/*
 * Abschluss-CTA einer Themenseite: genau eine Handlung am Seitenende.
 *
 * Steht in einem eigenen Band (siehe PageLayout). Mit `onBrand` sitzt er auf
 * dem Bordeaux-Band und bekommt den Gold-Button, sonst auf hellem Grund den
 * normalen Primärbutton.
 */
export interface Props {
  label: string;
  href: string;
  hint?: string;
  onBrand?: boolean;
}
const { label, href, hint, onBrand = false } = Astro.props;
---

<div class:list={['page-cta', onBrand && 'page-cta--on-brand']}>
  {hint && <p class="page-cta__hint">{hint}</p>}
  <a class:list={['btn', onBrand ? 'btn--gold' : 'btn--primary']} href={href}>{label}</a>
</div>

<style>
  .page-cta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg) var(--space-xl);
  }
  .page-cta__hint {
    margin: 0;
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 34rem;
  }
  .page-cta--on-brand .page-cta__hint {
    color: var(--text-on-dark);
  }
</style>
