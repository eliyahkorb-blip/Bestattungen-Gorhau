---
/*
 * Zurückhaltender Abschluss-CTA für Themenseiten: ein Link, kein volltoniges
 * Bordeaux-Panel (das bleibt der Startseite/CtaSection vorbehalten), damit
 * Bordeaux die Seite nicht dominiert.
 */
export interface Props {
  label: string;
  href: string;
  hint?: string;
}
const { label, href, hint } = Astro.props;
---

<p class="page-cta">
  {hint && <span class="page-cta__hint">{hint}</span>}
  <a class="btn btn--primary" href={href}>{label}</a>
</p>

<style>
  .page-cta {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }
  .page-cta__hint {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
