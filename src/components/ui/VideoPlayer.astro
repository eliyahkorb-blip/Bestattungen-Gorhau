---
/*
 * Vollständig funktionsfähiger Video-Player: Posterbild/Illustration + Play-Overlay,
 * Klick startet die Wiedergabe direkt im eingebetteten <video>-Element (keine
 * externen Player/Embeds), native Controls inkl. Vollbild, kein Autoplay beim Laden.
 *
 * Es liegt aktuell noch keine echte Videodatei vor (siehe docs/PHOTO-SHOOT-LIST.md) –
 * `sources` ist deshalb leer. Sobald eine MP4/WebM-Datei unter public/media/ abgelegt
 * wird, hier die `sources`-Liste befüllen; der Player funktioniert dann ohne weitere
 * Änderungen. Bis dahin zeigt ein Klick einen klaren, nicht kaputt wirkenden Hinweis
 * statt eines fehlerhaften Videos oder eines erfundenen Platzhalterfilms.
 */
import Motif from '../illustrations/Motif.astro';

export interface VideoSource {
  src: string;
  type: string;
}

export interface Props {
  title: string;
  sources?: VideoSource[];
  posterMotif?: 'gebaeude' | 'begleitung' | 'historie';
  id?: string;
  class?: string;
}

const { title, sources = [], posterMotif = 'gebaeude', id, class: klass = '' } = Astro.props;
const hasVideo = sources.length > 0;
---

<div class={`video-player ${klass}`} data-video-player id={id}>
  <div class="video-player__stage">
    <div class="video-player__poster" data-poster>
      <Motif name={posterMotif} label={`Vorschaubild: ${title}`} class="video-player__motif" />
      <button
        type="button"
        class="video-player__play"
        aria-label={`${title} abspielen`}
        data-play-btn
      >
        <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
          <circle cx="14" cy="14" r="13" fill="currentColor" opacity="0.12"></circle>
          <path d="M11 8.5l9 5.5-9 5.5z" fill="currentColor"></path>
        </svg>
      </button>
    </div>

    {
      hasVideo ? (
        <video
          class="video-player__video"
          data-video
          preload="none"
          controls
          playsinline
          hidden
          poster=""
          aria-label={title}
        >
          {sources.map((s) => (
            <source src={s.src} type={s.type} />
          ))}
          Ihr Browser unterstützt die Videowiedergabe nicht.
        </video>
      ) : (
        <div class="video-player__pending" data-pending hidden>
          <p>
            <strong>{title}</strong> wird derzeit produziert und in Kürze an dieser Stelle
            ergänzt.
          </p>
        </div>
      )
    }
  </div>
</div>

<style>
  .video-player__stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-dark);
  }
  .video-player__poster {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .video-player__poster :global(.video-player__motif) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .video-player__play {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--brand-white);
    color: var(--brand-bordeaux);
    border: 0;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .video-player__play:hover {
    transform: scale(1.06);
    background: var(--brand-gold);
  }
  .video-player__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #000;
  }
  .video-player__video[hidden] {
    display: none;
  }
  .video-player__pending {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-lg);
    text-align: center;
    background: var(--surface-dark);
    color: var(--text-on-dark);
  }
  .video-player__pending[hidden] {
    display: none;
  }
  .video-player__pending p {
    max-width: 24rem;
    margin: 0;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-player]').forEach((wrapper) => {
    const playBtn = wrapper.querySelector<HTMLButtonElement>('[data-play-btn]');
    const poster = wrapper.querySelector<HTMLElement>('[data-poster]');
    const video = wrapper.querySelector<HTMLVideoElement>('[data-video]');
    const pending = wrapper.querySelector<HTMLElement>('[data-pending]');

    playBtn?.addEventListener('click', () => {
      poster?.setAttribute('hidden', '');
      if (video) {
        video.hidden = false;
        video.play().catch(() => {
          /* Nutzerinteraktion liegt vor; Wiedergabefehler werden über die nativen
             Video-Controls sichtbar, kein zusätzlicher Fehlerzustand nötig. */
        });
      } else if (pending) {
        pending.hidden = false;
      }
    });
  });
</script>
