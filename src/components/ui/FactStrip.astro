---
export interface Fact {
  value: string;
  label: string;
}
export interface Props {
  facts: Fact[];
}
const { facts } = Astro.props;
---

<ul class="fact-strip">
  {
    facts.map((f) => (
      <li>
        <span class="fact-strip__value">{f.value}</span>
        <span class="fact-strip__label">{f.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .fact-strip {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-lg);
  }
  .fact-strip li {
    border-left: 2px solid var(--brand-gold);
    padding-left: var(--space-sm);
  }
  .fact-strip__value {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--brand-bordeaux-dark);
  }
  .fact-strip__label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
