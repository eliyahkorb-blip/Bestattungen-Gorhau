{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/im-trauerfall/index.html",
        "http://localhost/leistungen/index.html",
        "http://localhost/bestattungsarten/feuerbestattung/index.html",
        "http://localhost/abschiedsraum/index.html",
        "http://localhost/ueber-uns/index.html",
        "http://localhost/mediathek/index.html",
        "http://localhost/kontakt/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 1 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
