name: Deploy to GitHub Pages

on:
  push:
    branches:
      - claude/gorhau-bestattungen-relaunch-jmpxkg
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Repository laden
        uses: actions/checkout@v7

      - name: Astro installieren und bauen
        uses: withastro/action@v6

  deploy:
    needs: build
    runs-on: ubuntu-latest

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Website veröffentlichen
        id: deployment
        uses: actions/deploy-pages@v5
