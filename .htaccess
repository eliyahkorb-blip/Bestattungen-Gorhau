# ============================================================
# .htaccess – Bestattungen Gorhau (Apache / Hostinger)
# Kanonische Domain: https://www.gorhau-bestattungen.de
# ============================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTP -> HTTPS und Non-www -> www in EINEM Schritt (keine Ketten)
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.gorhau-bestattungen.de%{REQUEST_URI} [R=301,L]

  # 2) /index.html am Ende einer URL entfernen -> Verzeichnis-URL
  RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

  # 3) Alte URLs -> neue Zielseiten
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^institut/hauptstelle\.html$ /ueber-uns/ [R=301,L]
  RewriteRule ^institut/abschiedsraum\.html$ /abschiedsraum/ [R=301,L]
  RewriteRule ^institut/mediathek\.html$ /mediathek/ [R=301,L]
  RewriteRule ^institut/historie\.html$ /historie/ [R=301,L]
  RewriteRule ^institut/galerie\.html$ /ueber-uns/ [R=301,L]
  RewriteRule ^dienstleistung/thanatopraxie\.html$ /leistungen/ [R=301,L]
  RewriteRule ^dienstleistung/index\.html$ /leistungen/ [R=301,L]
  RewriteRule ^vorsorge/index\.html$ /vorsorge/ [R=301,L]
  RewriteRule ^trauerfall/index\.html$ /im-trauerfall/ [R=301,L]
  RewriteRule ^bestattungsarten/index\.html$ /bestattungsarten/ [R=301,L]
  RewriteRule ^kontakt/kontakt\.html$ /kontakt/ [R=301,L]
  RewriteRule ^kontakt/anfahrt\.html$ /kontakt/ [R=301,L]
  RewriteRule ^kontakt/impressum\.html$ /impressum/ [R=301,L]
  RewriteRule ^kontakt/datenschutz\.html$ /datenschutz/ [R=301,L]
  RewriteRule ^kontakt/index\.html$ /kontakt/ [R=301,L]
  RewriteRule ^institut/mediathek/gorhau_imagefilm\.flv$ /mediathek/ [R=301,L]
  RewriteRule ^institut/mediathek/mz_imagespot_2010\.flv$ /mediathek/ [R=301,L]
  RewriteRule ^institut/mediathek/mz_fernsehspot\.flv$ /mediathek/ [R=301,L]
  RewriteRule ^institut/mediathek/radiospot_11_2009\.flv$ /mediathek/ [R=301,L]
  RewriteRule ^institut/mediathek/tagderoffenentuer2012\.jpg$ /mediathek/ [R=301,L]
  RewriteRule ^institut/mediathek/flyer_2009\.jpg$ /mediathek/ [R=301,L]
  RewriteRule ^vorsorge/GN750\.pdf$ /vorsorge/ [R=301,L]
  RewriteRule ^bestattungsarten/urnengarten\.pdf$ /bestattungsarten/ [R=301,L]
  RewriteRule ^institut/$ /ueber-uns/ [R=301,L]
  RewriteRule ^dienstleistung/$ /leistungen/ [R=301,L]
  RewriteRule ^trauerfall/$ /im-trauerfall/ [R=301,L]

  # 4) UX-Rework 2026: zusammengelegte Seiten -> jeweilige Hauptseite
  RewriteRule ^bestattungsarten/(erdbestattung|feuerbestattung|seebestattung|anonyme-bestattung)/?$ /bestattungsarten/ [R=301,L]
  RewriteRule ^im-trauerfall/benoetigte-dokumente/?$ /im-trauerfall/ [R=301,L]
  RewriteRule ^leistungen/(formalitaeten|ueberfuehrungen|thanatopraxie|trauerfeier-und-trauerdruck)/?$ /leistungen/ [R=301,L]
  RewriteRule ^bestattungsvorsorge/?$ /vorsorge/ [R=301,L]
  RewriteRule ^ueber-uns/historie/?$ /historie/ [R=301,L]
  RewriteRule ^ueber-uns/galerie/?$ /ueber-uns/ [R=301,L]
  RewriteRule ^friedhoefe-in-wuerzburg/?$ /friedhoefe/ [R=301,L]
</IfModule>

# ---------- Sicherheits-Header ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; media-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  # HSTS erst aktivieren, wenn HTTPS dauerhaft fuer die gesamte Domain sichergestellt ist:
  # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>

# ---------- Kompression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json image/svg+xml application/xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml application/javascript application/json image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|png|jpe?g|svg|woff2|mp4|webm|mp3|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------- Fehlerseite ----------
ErrorDocument 404 /404.html
